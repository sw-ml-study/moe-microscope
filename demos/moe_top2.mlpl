# MX02 top-2 mixture of experts: the MX01 model routed to two experts per token with renormalized gates, plus the family-by-expert specialization map compared with MX01.
include "../lib/dense.mlpl";
include "../lib/moe.mlpl";
include "../lib/observe.mlpl";
include "../lib/svg.mlpl";
include "../lib/results.mlpl";

print("WHAT THIS SHOWS -- Top-2 routing: each token combines its two best experts with renormalized gates, doubling active expert compute; and the specialization map: which task family each expert ends up serving, for MX01 and MX02 side by side.");
print("SHAPES -- ids:[T], embedding:[T,16], router logits/gate:[T,4], each expert 16->32->16, logits:[T,52]; 120 examples, 90 train / 30 validation.");

out_dir = if list_len(args()) {
  unwrap(list_get(args(), 0))
} else {
  ""
};
binary = if gt(list_len(args()), 1) {
  unwrap(list_get(args(), 1))
} else {
  "unknown"
};
writing = str_len(out_dir);
m = unwrap(u:domain_load_mixture(u:domain_mixture_path()));
d = u:domain_build(m);
w = unwrap(u:domain_windows(d.texts, m.window));
s = u:domain_split(d.count, m.train_fraction, m.seed);
V = u:domain_vocab_size();
T = m.window;
dm = 16;
hidden = 32;
E = 4;
epochs = 300;
lr = 0.003;
alpha = 0.01;
every = 25;
ntrain = reduce_mul(shape(s.train));
nval = reduce_mul(shape(s.val));
train_x = gather_rows(w.x, s.train);
train_y = gather_rows(w.y, s.train);
train_m = gather_rows(w.mask, s.train);
val_x = gather_rows(w.x, s.val);
val_y = gather_rows(w.y, s.val);
val_m = gather_rows(w.mask, s.val);
train_tags = reshape(gather_rows(reshape(d.tags, [d.count, 1]), s.train), [ntrain]);
posT = u:positions(T, dm);
ones_ee = fill([E, E], 1);
config = emit_frame("moe2/config", 0, [dm, hidden, E, 2, T, epochs, ntrain, nval]);

emb = embed(V, dm, 0);
att = chain(rms_norm(dm), causal_attention(dm, 1, 1));
pre = rms_norm(dm);
router = linear(dm, E, 9);
ex0 = chain(linear(dm, hidden, 20), relu_layer(), linear(hidden, dm, 21));
ex1 = chain(linear(dm, hidden, 22), relu_layer(), linear(hidden, dm, 23));
ex2 = chain(linear(dm, hidden, 24), relu_layer(), linear(hidden, dm, 25));
ex3 = chain(linear(dm, hidden, 26), relu_layer(), linear(hidden, dm, 27));
norm = rms_norm(dm);
head = linear(dm, V, 4);

def u:moe_block(h1) {
  "Dense-masked top-2 mixture over a T-length window: every expert runs; the renormalized top-2 gate keeps each token's two chosen experts.";
  x = apply(pre, h1);
  gate = u:top2_gate(apply(router, x), E, ones_ee);
  reshape(take(gate, 1, 0), [T, 1]) * apply(ex0, x) + reshape(take(gate, 1, 1), [T, 1]) * apply(ex1, x) + reshape(take(gate, 1, 2), [T, 1]) * apply(ex2, x) + reshape(take(gate, 1, 3), [T, 1]) * apply(ex3, x)
}

def u:body(h0) {
  "Residual attention block, residual mixture block, norm, head.";
  h1 = h0 + apply(att, h0);
  h2 = h1 + u:moe_block(h1);
  apply(head, apply(norm, h2))
}

def u:balance_at(h0) {
  "The Switch load-balance term of this window's routing.";
  h1 = h0 + apply(att, h0);
  logits = apply(router, apply(pre, h1));
  u:balance_loss(u:router_probs(logits), u:top2_mask(logits, E), E, 2 * T)
}

def u:forward(x1) {
  "Logits for one full T-length window.";
  u:body(apply(emb, x1) + posT)
}

def u:routing_of(x1) {
  "Router logits [T, E] of one window, eagerly.";
  h0 = apply(emb, x1) + posT;
  h1 = h0 + apply(att, h0);
  apply(router, apply(pre, h1))
}

def u:train_routing() {
  "Over every masked training position: tokens per expert, family-by-expert counts [4, E], mean entropy, and mean balance.";
  load = fill([E], 0);
  fam = fill([4, E], 0);
  ent = 0;
  bal = 0;
  i = 0;
  while lt(i, ntrain) {
    logits = u:routing_of(take(train_x, 0, i));
    mrow = reshape(take(train_m, 0, i), [T, 1]);
    mask = u:top2_mask(logits, E) * mrow;
    counts = u:expert_load(mask);
    load = load + counts;
    fam = fam + reshape(one_hot([take(train_tags, 0, i)], 4), [4, 1]) * reshape(counts, [1, E]);
    probs = u:router_probs(logits);
    ent = ent + u:router_entropy(probs);
    bal = bal + u:balance_loss(probs, u:top2_mask(logits, E), E, 2 * T);
    i = i + 1
  };
  {load: load, family: fam, entropy: ent / ntrain, balance: bal / ntrain}
}

p_emb = param_count(emb);
p_att = param_count(att);
p_router = param_count(router) + param_count(pre);
p_expert = param_count(ex0);
p_head = param_count(norm) + param_count(head);
params = p_emb + p_att + p_router + E * p_expert + p_head;
active = params - p_emb + dm - (E - 2) * p_expert;
print("MODEL -- params", params, "of which router", p_router, "each expert", p_expert, "; active per token", active, "(two experts)");

curve_e = fill([0], 0);
curve_t = fill([0], 0);
curve_v = fill([0], 0);
curve_load = fill([0, E], 0);
curve_ent = fill([0], 0);
curve_bal = fill([0], 0);
train_ms = 0;
e = 0;
while lt(e, epochs) {
  ts = clock_ms();
  i = 0;
  while lt(i, ntrain) {
    x1 = take(train_x, 0, i);
    y1 = take(train_y, 0, i);
    m1 = take(train_m, 0, i);
    adam(u:masked_ce(u:body(apply(emb, x1) + posT), y1, m1, V) + alpha * u:balance_at(apply(emb, x1) + posT), [emb, att, pre, router, ex0, ex1, ex2, ex3, norm, head], lr, 0.9, 0.999, 0.00000001);
    i = i + 1
  };
  train_ms = train_ms + (clock_ms() - ts);
  e = e + 1;
  if eq(mod(e, every), 0) {
    tl = emit_frame("moe2/loss/train", e, u:set_loss(:u:forward, train_x, train_y, train_m, ntrain, V));
    vl = emit_frame("moe2/loss/val", e, u:set_loss(:u:forward, val_x, val_y, val_m, nval, V));
    st = u:train_routing();
    ld = emit_frame("moe2/load", e, st.load);
    en = emit_frame("moe2/entropy", e, st.entropy);
    ba = emit_frame("moe2/balance", e, st.balance);
    curve_e = concat(curve_e, e);
    curve_t = concat(curve_t, tl);
    curve_v = concat(curve_v, vl);
    curve_load = concat(curve_load, reshape(ld, [1, E]), 0);
    curve_ent = concat(curve_ent, en);
    curve_bal = concat(curve_bal, ba);
    print("epoch", e, "train", u:svg_round(tl, 4), "val", u:svg_round(vl, 4), "load", ld, "entropy", u:svg_round(en, 3), "balance", u:svg_round(ba, 3))
  } else {
    0
  }
};
steps = epochs * ntrain;
ms_per_token = train_ms / (steps * T);
final = u:train_routing();
family = emit_frame("moe2/family-by-expert", epochs, final.family);
rv = u:evaluate_prompts_padded(:u:forward, d, s.val, 12, T);
rt = u:evaluate_prompts_padded(:u:forward, d, s.train, 12, T);
val_acc = emit_frame("moe2/accuracy/val", epochs, [rv.accuracy.arithmetic, rv.accuracy.sequence, rv.accuracy.mlpl, rv.accuracy.prose, rv.accuracy.overall]);
train_acc = emit_frame("moe2/accuracy/train", epochs, [rt.accuracy.arithmetic, rt.accuracy.sequence, rt.accuracy.mlpl, rt.accuracy.prose, rt.accuracy.overall]);
final_train = take(curve_t, 0, reduce_mul(shape(curve_t)) - 1);
final_val = take(curve_v, 0, reduce_mul(shape(curve_v)) - 1);
example = "2+3=|5.";
ex_ids = u:pad_to(unwrap(u:domain_encode(example)), T);
ex_logits = u:routing_of(ex_ids);
ex_route = emit_frame("moe2/route/example", epochs, gather_rows(u:top2_mask(ex_logits, E), range(7)));
ex_probs = gather_rows(u:router_probs(ex_logits), range(7));

row = {lesson: "MX02", config: "moe E4 top2 d16 h32 1head T28 120ex 300ep lr0.003 alpha0.01", binary: binary, params: params, active_params: active, expert_evals: 2, bytes_per_token: active * 8, ms_per_token: u:svg_round(ms_per_token, 4), val_loss: u:svg_round(final_val, 4), ppl: u:svg_round(exp(final_val), 2), arith_acc: u:svg_round(rv.accuracy.arithmetic, 3), seq_acc: u:svg_round(rv.accuracy.sequence, 3), mlpl_acc: u:svg_round(rv.accuracy.mlpl, 3), prose_acc: u:svg_round(rv.accuracy.prose, 3), router_entropy: u:svg_round(final.entropy, 3), balance: u:svg_round(final.balance, 3)};
r_row = if writing {
  write_atomic(str_concat(out_dir, "/results-row.md"), str_concat(u:results_row(row), "\n"))
} else {
  ok(0)
};
print("MEMORY -- params", params, "active/token", active, "bytes/token (f64)", active * 8);
print("SPEED -- ms/token", u:svg_round(ms_per_token, 4), "expert evals/token 2 of", E, "(", binary, ")");
print("QUALITY -- train loss", u:svg_round(final_train, 4), "val loss", u:svg_round(final_val, 4), "val acc", val_acc, "train acc", train_acc, "entropy", u:svg_round(final.entropy, 3), "balance", u:svg_round(final.balance, 3));
print("ROUTING -- final load", final.load, "family-by-expert rows arithmetic/sequence/mlpl/prose:", final.family);

mx1 = unwrap(parse_json(unwrap(read_text("fixtures/moe/mx01-family-by-expert.json"))));
mx1_counts = reshape(mx1.counts, [4, E]);
mx2_counts = final.family;
spec1 = u:specialization_score(mx1_counts);
spec2 = emit_frame("moe2/specialization", epochs, u:specialization_score(mx2_counts));
print("SPECIALIZATION -- MX01 top-1 score", u:svg_round(spec1, 3), "MX02 top-2 score", u:svg_round(spec2, 3), "(0.25 = family-blind, 1 = one expert per family)");

def u:family_heat(counts, x0, y0) {
  "Row-normalized family-by-expert shares as a heatmap with family labels.";
  shares = u:row_normalize(counts);
  names = u:domain_tag_names();
  out = u:svg_heat(shares, x0 + 90, y0, 44);
  i = 0;
  while lt(i, 4) {
    out = str_concat(out, u:svg_text(x0, y0 + i * 44 + 26, "", unwrap(list_get(names, i))));
    i = i + 1
  };
  str_concat(out, str_concat(str_concat(str_concat(u:svg_text(x0 + 100, y0 - 8, "s", "e0"), u:svg_text(x0 + 144, y0 - 8, "s", "e1")), u:svg_text(x0 + 188, y0 - 8, "s", "e2")), u:svg_text(x0 + 232, y0 - 8, "s", "e3")))
}

def u:specialization_svg() {
  "Diagram: family-by-expert share heatmaps for MX01 (top-1) and MX02 (top-2), their specialization scores, and the raw counts.";
  page = u:svg_head("MX02 specialization map", "Two heatmaps show, for each task family, the share of its answer tokens routed to each of four experts after training, for top-1 routing (MX01) and top-2 routing (MX02), with the specialization score of each; 0.25 would mean routing ignores the family and 1 would mean one expert per family.");
  page = str_concat(page, u:svg_text(32, 36, "h", "MX02 SPECIALIZATION -- which expert serves which task family"));
  page = str_concat(page, u:svg_text(32, 60, "m", "WHAT: counts[family, expert] over masked training tokens, row-normalized; score = mean over families of the largest share"));
  page = str_concat(page, u:svg_text(32, 96, "k", str_concat("MX01 top-1   score ", u:svg_num(u:svg_round(spec1, 3)))));
  page = str_concat(page, u:family_heat(mx1_counts, 32, 120));
  page = str_concat(page, u:svg_text(400, 96, "k", str_concat("MX02 top-2   score ", u:svg_num(u:svg_round(spec2, 3)))));
  page = str_concat(page, u:family_heat(mx2_counts, 400, 120));
  page = str_concat(page, u:svg_text(720, 120, "", "raw counts, MX02 (rows: families)"));
  page = str_concat(page, u:svg_text(720, 142, "s", u:svg_vec(take(mx2_counts, 0, 0), 0)));
  page = str_concat(page, u:svg_text(720, 160, "s", u:svg_vec(take(mx2_counts, 0, 1), 0)));
  page = str_concat(page, u:svg_text(720, 178, "s", u:svg_vec(take(mx2_counts, 0, 2), 0)));
  page = str_concat(page, u:svg_text(720, 196, "s", u:svg_vec(take(mx2_counts, 0, 3), 0)));
  page = str_concat(page, u:svg_text(720, 230, "", "family-blind: every row 0.25"));
  page = str_concat(page, u:svg_text(720, 250, "", "one expert per family: 1.0"));
  page = str_concat(page, u:svg_text(32, 330, "k", "reading the map"));
  page = str_concat(page, u:svg_text(32, 352, "", "A column that is bright in one row and dark in the others is an expert that one family owns."));
  page = str_concat(page, u:svg_text(32, 372, "", "A row that is bright across columns is a family whose tokens are spread over experts (top-2 spreads by construction)."));
  page = str_concat(page, u:svg_text(32, 392, "", "Nothing here was labeled: the router saw hidden states, never the family tag. Specialization is emergent, or absent."));
  page = str_concat(page, u:svg_rect(30, 430, 900, 106, "panel"));
  page = str_concat(page, u:svg_text(50, 456, "", "WHY: the plan promised to measure specialization, not assume it; this map is also the target of the Saga 4 router warm start."));
  page = str_concat(page, u:svg_text(50, 478, "", "WHY: prose and arithmetic have distinct surface statistics and separate first; sequence and mlpl share digits and stay mixed."));
  page = str_concat(page, u:svg_text(50, 500, "", "HOW: u:top2_mask * mask row, one_hot(tag) outer counts, u:row_normalize, u:specialization_score; MX01 from its fixture."));
  page = str_concat(page, u:svg_text(50, 522, "m", "Observations moe2/family-by-expert and moe2/specialization; the MX01 fixture is regenerated by just moe write."));
  str_concat(page, "</svg>")
}

def u:cost_row(y, label, left, right) {
  "One table row: label, MX01 value, MX02 value at fixed columns.";
  str_concat(str_concat(u:svg_text(32, y, "", label), u:svg_text(300, y, "", left)), u:svg_text(520, y, "", right))
}

def u:cost_svg() {
  "Diagram: top-1 versus top-2 cost and quality side by side, from the MX01 fixture and this run.";
  active1 = params - p_emb + dm - (E - 1) * p_expert;
  page = u:svg_head("MX02 top-1 versus top-2", "Top-2 routing doubles the expert parameters touched per token; the table compares MX01 and MX02 on active parameters, expert evaluations, validation loss, per-family validation accuracy, router entropy, balance, and specialization.");
  page = str_concat(page, u:svg_text(32, 36, "h", "MX02 COST -- is the second expert worth doubling active compute?"));
  page = str_concat(page, u:svg_text(32, 60, "m", "WHAT: the same 7,096-parameter model with k = 1 (MX01) and k = 2 (MX02); everything else identical"));
  page = str_concat(page, str_concat(u:svg_text(300, 96, "k", "MX01 top-1"), u:svg_text(520, 96, "k", "MX02 top-2")));
  page = str_concat(page, u:cost_row(122, "active params / token", u:svg_num(active1), u:svg_num(active)));
  page = str_concat(page, u:cost_row(144, "expert evals / token", "1", "2"));
  page = str_concat(page, u:cost_row(166, "bytes / token (f64)", u:svg_num(active1 * 8), u:svg_num(active * 8)));
  page = str_concat(page, u:cost_row(188, "validation loss", u:svg_num(u:svg_round(mx1.val_loss, 4)), u:svg_num(u:svg_round(final_val, 4))));
  page = str_concat(page, u:cost_row(210, "val acc arith seq mlpl prose", u:svg_vec(u:domain_slice(mx1.val_accuracy, 0, 4), 2), u:svg_vec(u:domain_slice(val_acc, 0, 4), 2)));
  page = str_concat(page, u:cost_row(232, "train exact match", u:svg_num(u:svg_round(take(mx1.train_accuracy, 0, 4), 3)), u:svg_num(u:svg_round(take(train_acc, 0, 4), 3))));
  page = str_concat(page, u:cost_row(254, "router entropy (nats)", u:svg_num(u:svg_round(mx1.entropy, 3)), u:svg_num(u:svg_round(final.entropy, 3))));
  page = str_concat(page, u:cost_row(276, "balance (1.0 = even)", u:svg_num(u:svg_round(mx1.balance, 3)), u:svg_num(u:svg_round(final.balance, 3))));
  page = str_concat(page, u:cost_row(298, "specialization score", u:svg_num(u:svg_round(spec1, 3)), u:svg_num(u:svg_round(spec2, 3))));
  page = str_concat(page, u:svg_text(32, 340, "k", str_concat("routing of ", str_concat(example, " under top-2 (first 4 positions; two experts per row)"))));
  page = str_concat(page, u:svg_grid(gather_rows(ex_route, range(4)), 32, 348, 44, 0, gather_rows(ex_route, range(4))));
  page = str_concat(page, u:svg_text(240, 372, "", "each row selects two of four experts;"));
  page = str_concat(page, u:svg_text(240, 392, "", "their gates are renormalized to sum to one."));
  page = str_concat(page, u:svg_rect(30, 466, 900, 70, "panel"));
  page = str_concat(page, u:svg_text(50, 488, "", "WHY: top-2 buys a differentiable gate and a second opinion per token at twice the expert cost; the table shows the price."));
  page = str_concat(page, u:svg_text(50, 508, "", "HOW: u:top2_mask (two argmax passes, constants on the tape); u:top2_gate renormalized by a ones matmul; balance over 2T."));
  page = str_concat(page, u:svg_text(50, 528, "m", "Bytes assume f64 weights; quantization lessons shrink them, cache lessons decide which are resident."));
  str_concat(page, "</svg>")
}

r1 = if writing {
  write_atomic(str_concat(out_dir, "/moe2-specialization.svg"), u:specialization_svg())
} else {
  ok(0)
};
r2 = if writing {
  write_atomic(str_concat(out_dir, "/moe2-cost.svg"), u:cost_svg())
} else {
  ok(0)
};
print("NUMERICAL CONTRACT -- training loss ends below 0.3; every expert receives at least 5 percent of top-2 selections; balance ends below 2.5; both specialization scores lie in [0.25, 1].");
print("THE POINT -- Whether experts specialize is measured, not assumed; top-2 spreads tokens by construction, so its map is flatter.");
print("BOUNDARY -- Four experts and four families on 90 rows; a score near 0.25 means no separation emerged at this scale, which is itself the result.");
min_share = reduce(:min, final.load) / reduce_add(final.load);
contract = lt(final_train, 0.3) * gt(min_share, 0.05) * lt(final.balance, 2.5) * gt(spec2, 0.24) * lt(spec2, 1.01) * gt(spec1, 0.24);
if contract * is_ok(r1) * is_ok(r2) * is_ok(r_row) {
  ok("moe top-2 written")
} else {
  err("moe top-2 contract failed")
}
