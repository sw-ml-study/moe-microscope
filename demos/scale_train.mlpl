# DS01 trainer: train DN01 (dense) or MX01 (moe top-1) at a chosen example count and epoch budget, and write one measured sweep point as JSON.
include "../lib/dense.mlpl";
include "../lib/moe.mlpl";
include "../lib/scale.mlpl";
include "../lib/svg.mlpl";
include "../lib/results.mlpl";

kind = unwrap(list_get(args(), 0));
total = to_number(unwrap(list_get(args(), 1)))?;
epochs = to_number(unwrap(list_get(args(), 2)))?;
out_path = unwrap(list_get(args(), 3));
binary = if gt(list_len(args()), 4) {
  unwrap(list_get(args(), 4))
} else {
  "unknown"
};
is_moe = str_eq(kind, "moe");
m = u:scale_mixture(total);
d = u:domain_build(m);
w = unwrap(u:domain_windows(d.texts, m.window));
s = u:domain_split(d.count, m.train_fraction, m.seed);
V = u:domain_vocab_size();
T = m.window;
dm = 16;
hidden = 32;
E = 4;
lr = 0.003;
alpha = 0.01;
every = 50;
ntrain = reduce_mul(shape(s.train));
nval = reduce_mul(shape(s.val));
train_x = gather_rows(w.x, s.train);
train_y = gather_rows(w.y, s.train);
train_m = gather_rows(w.mask, s.train);
val_x = gather_rows(w.x, s.val);
val_y = gather_rows(w.y, s.val);
val_m = gather_rows(w.mask, s.val);
posT = u:positions(T, dm);
print("DS01 --", kind, "at", total, "examples (", ntrain, "train /", nval, "val ) for", epochs, "epochs");

emb = embed(V, dm, 0);
att = chain(rms_norm(dm), causal_attention(dm, 1, 1));
ffn = chain(rms_norm(dm), linear(dm, hidden, 2), relu_layer(), linear(hidden, dm, 3));
pre = rms_norm(dm);
router = linear(dm, E, 9);
ex0 = chain(linear(dm, hidden, 20), relu_layer(), linear(hidden, dm, 21));
ex1 = chain(linear(dm, hidden, 22), relu_layer(), linear(hidden, dm, 23));
ex2 = chain(linear(dm, hidden, 24), relu_layer(), linear(hidden, dm, 25));
ex3 = chain(linear(dm, hidden, 26), relu_layer(), linear(hidden, dm, 27));
norm = rms_norm(dm);
head = linear(dm, V, 4);

def u:moe_block(h1) {
  "Dense-masked top-1 mixture over a T-length window.";
  x = apply(pre, h1);
  gate = u:switch_gate(apply(router, x), E);
  reshape(take(gate, 1, 0), [T, 1]) * apply(ex0, x) + reshape(take(gate, 1, 1), [T, 1]) * apply(ex1, x) + reshape(take(gate, 1, 2), [T, 1]) * apply(ex2, x) + reshape(take(gate, 1, 3), [T, 1]) * apply(ex3, x)
}

def u:body_dense(h0) {
  "DN01 body.";
  h1 = h0 + apply(att, h0);
  apply(head, apply(norm, h1 + apply(ffn, h1)))
}

def u:body_moe(h0) {
  "MX01 body.";
  h1 = h0 + apply(att, h0);
  apply(head, apply(norm, h1 + u:moe_block(h1)))
}

def u:balance_at(h0) {
  "MX01 balance term.";
  h1 = h0 + apply(att, h0);
  logits = apply(router, apply(pre, h1));
  u:balance_loss(u:router_probs(logits), u:top1_mask(logits, E), E, T)
}

def u:forward(x1) {
  "Logits for one full window under the selected model kind.";
  if is_moe { u:body_moe(apply(emb, x1) + posT) } else { u:body_dense(apply(emb, x1) + posT) }
}

curve_e = fill([0], 0);
curve_t = fill([0], 0);
curve_v = fill([0], 0);
train_ms = 0;
e = 0;
while lt(e, epochs) {
  ts = clock_ms();
  i = 0;
  while lt(i, ntrain) {
    x1 = take(train_x, 0, i);
    y1 = take(train_y, 0, i);
    m1 = take(train_m, 0, i);
    if is_moe {
      adam(u:masked_ce(u:body_moe(apply(emb, x1) + posT), y1, m1, V) + alpha * u:balance_at(apply(emb, x1) + posT), [emb, att, pre, router, ex0, ex1, ex2, ex3, norm, head], lr, 0.9, 0.999, 0.00000001)
    } else {
      adam(u:masked_ce(u:body_dense(apply(emb, x1) + posT), y1, m1, V), [emb, att, ffn, norm, head], lr, 0.9, 0.999, 0.00000001)
    };
    i = i + 1
  };
  train_ms = train_ms + (clock_ms() - ts);
  e = e + 1;
  if eq(mod(e, every), 0) {
    tl = u:set_loss(:u:forward, train_x, train_y, train_m, ntrain, V);
    vl = u:set_loss(:u:forward, val_x, val_y, val_m, nval, V);
    curve_e = concat(curve_e, e);
    curve_t = concat(curve_t, tl);
    curve_v = concat(curve_v, vl);
    print("epoch", e, "train", u:svg_round(tl, 4), "val", u:svg_round(vl, 4), "ms", round(train_ms))
  } else {
    0
  }
};
rv = u:evaluate_prompts_padded(:u:forward, d, s.val, 12, T);
rt = u:evaluate_prompts_padded(:u:forward, d, u:domain_slice(s.train, 0, nval), 12, T);
acc = [rv.accuracy.arithmetic, rv.accuracy.sequence, rv.accuracy.mlpl, rv.accuracy.prose, rv.accuracy.overall];
tacc = [rt.accuracy.arithmetic, rt.accuracy.sequence, rt.accuracy.mlpl, rt.accuracy.prose, rt.accuracy.overall];
point = u:scale_point(kind, total, epochs, curve_e, curve_t, curve_v, acc, tacc, round(train_ms));
print("RESULT --", kind, total, "examples", epochs, "epochs: val loss", u:svg_round(point.final_val, 4), "val acc", acc, "train acc (first", nval, "rows)", u:svg_round(point.train_overall, 3), "train ms", round(train_ms));
lesson = if is_moe {
  "MX01"
} else {
  "DN01"
};
row = {lesson: str_concat(lesson, str_concat("@", u:svg_num(total))), config: str_concat(str_concat(str_concat(kind, " "), str_concat(u:svg_num(total), "ex ")), str_concat(u:svg_num(epochs), "ep lr0.003 (DS01)")), binary: binary, params: if is_moe {
    7096
  } else {
    3812
  }, active_params: if is_moe {
    3064
  } else {
    2996
  }, expert_evals: 1, ms_per_token: u:svg_round(train_ms / (epochs * ntrain * T), 4), val_loss: u:svg_round(point.final_val, 4), ppl: u:svg_round(exp(point.final_val), 2), arith_acc: u:svg_round(rv.accuracy.arithmetic, 3), seq_acc: u:svg_round(rv.accuracy.sequence, 3), mlpl_acc: u:svg_round(rv.accuracy.mlpl, 3), prose_acc: u:svg_round(rv.accuracy.prose, 3)};
r1 = write_atomic(out_path, unwrap(to_json(point)));
r2 = write_atomic(str_concat(out_path, ".row"), str_concat(u:results_row(row), "\n"));
if is_ok(r1) * is_ok(r2) {
  ok("point written")
} else {
  err("point not written")
}
