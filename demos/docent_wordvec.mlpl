# CD01b docent word vectors: vectors trained on the campus's own text (co-occurrence, positive PMI, orthogonal iteration), stored in an Engram-style hashed table, then the same dense docent as CD01 trained on top of it; one variant per process (third argument finetuned or frozen: adam state is keyed by name, finding F22), measured against CD01 and the matchers.
include "../lib/wordvec.mlpl";
include "../lib/svg.mlpl";

print("WHAT THIS SHOWS -- Whether in-domain word vectors give the docent meaning its hashed features lack: the vectors, their neighbours, the hashed table, and the docent trained on top, measured on the same held-out rows and paraphrases as CD01 and the matchers.");
print("SHAPES -- corpus tokens [N]; vocabulary V; co-occurrence and PPMI [V, V]; vectors [V, 24]; table [1024, 24]; the docent as CD01 with the table in place of the embedding.");

out_dir = unwrap(list_get(args(), 0));
binary = unwrap(list_get(args(), 1));
variant = if gt(list_len(args()), 2) {
  unwrap(list_get(args(), 2))
} else {
  "finetuned"
};
fine_tune = str_eq(variant, "finetuned");
S = 1024;
dm = 24;
hd = 32;
ni = 6;
lr = 0.003;
epochs = 40;
every = 5;
window = 4;
iters = 5;

text = unwrap(read_text("fixtures/campus/docs-a.txt"));
docs_bytes = reduce_mul(shape(tokenize_bytes(text)));
t_v = clock_ms();
vocab = u:wv_vocab(text, 2);
C = u:wv_cooccurrence(vocab.ids, vocab.sids, vocab.size, window);
P = u:wv_ppmi(C);
W = u:wv_factor(P, dm, iters, 7);
tb = u:wv_table(W, vocab, S, 3);
vectors_ms = clock_ms() - t_v;
print("VECTORS -- vocabulary", vocab.size, "of", vocab.tokens, "content tokens; PPMI nonzero", reduce_add(gt(P, 0)), "; table filled", tb.filled, "collisions", tb.collisions, "; ms", u:svg_round(vectors_ms, 0));

def u:neighbour_line(w, k) {
  "A word and its k nearest vocabulary words as one line, or a note when the word is out of vocabulary.";
  i = u:wv_word_index(vocab, w);
  if lt(i, 0) {
    str_concat(w, ": not in the vocabulary (seen fewer than twice)")
  } else {
    nb = u:wv_neighbours(W, i, k);
    line = str_concat(w, ":");
    j = 0;
    while lt(j, k) {
      line = str_concat(str_concat(line, " "), u:lg(vocab.words, take(nb, 0, j)));
      j = j + 1
    };
    line
  }
}

probe_words = str_split("switches|glyphs|disk|jupiter|apl|minicomputer|cosmac|router", "|");
c = u:campus_load("fixtures/campus/snapshot-a.json");
k = unwrap(parse_json(unwrap(read_text("fixtures/campus/corpus-a.json"))));
pp = unwrap(parse_json(unwrap(read_text("fixtures/campus/paraphrases-a.json"))));
dest_names = u:dest_names(c);
nd = list_len(dest_names);
feat = u:docent_matrix(k.queries, S);
X = feat.ids;
M = feat.mask;
Cn = feat.counts;
lab = u:docent_labels(c, k.intents, k.dests);
Yi = lab.yi;
Yd = lab.yd;
member = k.train;
train_rows = compress(member, range(k.n));
val_rows = compress(1 - member, range(k.n));
ntrain = reduce_mul(shape(train_rows));
nval = reduce_mul(shape(val_rows));
yi_val = reshape(gather_rows(reshape(Yi, [k.n, 1]), val_rows), [nval]);
yd_val = reshape(gather_rows(reshape(Yd, [k.n, 1]), val_rows), [nval]);
ex_ids = [u:dest_index(c, "ibm-1130-emulator"), u:dest_index(c, "rca-1802"), u:dest_index(c, "apl")];
exhibit_sel = eq(yd_val, take(ex_ids, 0, 0)) + eq(yd_val, take(ex_ids, 0, 1)) + eq(yd_val, take(ex_ids, 0, 2));
pfeat = u:docent_matrix(pp.queries, S);
plab = u:docent_labels(c, pp.intents, pp.dests);
np_rows = list_len(pp.queries);
PX = pfeat.ids;
PM = pfeat.mask;
PC = pfeat.counts;
PYi = plab.yi;
PYd = plab.yd;
amb_rows = fill([0], 0);
amb_a = fill([0], 0);
amb_b = fill([0], 0);
j = 0;
i = 0;
while lt(i, k.n) {
  is_amb = str_eq(u:lg(k.kinds, i), "ambiguous");
  amb_rows = if is_amb {
    concat(amb_rows, i)
  } else {
    amb_rows
  };
  pair = if is_amb {
    str_split(u:lg(c.ambiguous_dests, j), ",")
  } else {
    str_split("none,none", ",")
  };
  amb_a = if is_amb {
    concat(amb_a, u:dest_index(c, u:lg(pair, 0)))
  } else {
    amb_a
  };
  amb_b = if is_amb {
    concat(amb_b, u:dest_index(c, u:lg(pair, 1)))
  } else {
    amb_b
  };
  j = j + is_amb;
  i = i + 1
};

# Training runs at top level (finding F21) and once per process (finding F22).
docent_table = param[1024, 24];
docent_table = tb.table;
docent_body = chain(linear(dm, hd, 2), relu_layer());
docent_head_i = linear(hd, ni, 3);
docent_head_d = linear(hd, nd, 4);
p_table = S * dm;
p_body = param_count(docent_body);
p_heads = param_count(docent_head_i) + param_count(docent_head_d);
params = p_table + p_body + p_heads;

def u:measure(label) {
  "Every CD01 metric for the current table docent.";
  t0 = clock_ms();
  ev = u:docent_eval_t(X, M, Cn, Yi, Yd, val_rows, ni, nd);
  ms = (clock_ms() - t0) / nval;
  et = u:docent_eval_t(X, M, Cn, Yi, Yd, train_rows, ni, nd);
  pv = u:docent_eval_t(PX, PM, PC, PYi, PYd, range(np_rows), ni, nd);
  exhibit_acc = reduce_add(ev.hit_d * exhibit_sel) / reduce_add(exhibit_sel);
  unsupported_recall = u:acc_where(ev.hit_i, yi_val, u:intent_index("unsupported"));
  amb = u:top2_set_hits_t(X, M, Cn, amb_rows, amb_a, amb_b, nd);
  print("QUALITY --", label, "val loss", u:svg_round(ev.loss, 4), "intent acc", u:svg_round(ev.intent_acc, 3), "dest acc", u:svg_round(ev.dest_acc, 3), "top-3", u:svg_round(ev.top3_acc, 3), "exhibit acc", u:svg_round(exhibit_acc, 3), "ambiguous top-2", u:svg_round(amb, 3), "unsupported recall", u:svg_round(unsupported_recall, 3), "paraphrase dest/intent", u:svg_round(pv.dest_acc, 3), u:svg_round(pv.intent_acc, 3), "train acc", u:svg_round(et.intent_acc, 3), u:svg_round(et.dest_acc, 3));
  {ev: ev, et: et, pv: pv, exhibit_acc: exhibit_acc, unsupported_recall: unsupported_recall, amb: amb, ms: ms}
}

curve_t = fill([0], 0);
curve_v = fill([0], 0);
curve_d = fill([0], 0);
train_ms = 0;
e = 0;
while lt(e, epochs) {
  ts = clock_ms();
  i = 0;
  while lt(i, ntrain) {
    r = take(train_rows, 0, i);
    if fine_tune {
      adam(u:docent_loss_t(take(X, 0, r), take(M, 0, r), take(Cn, 0, r), take(Yi, 0, r), take(Yd, 0, r), ni, nd), [docent_table, docent_body, docent_head_i, docent_head_d], lr, 0.9, 0.999, 0.00000001)
    } else {
      adam(u:docent_loss_t(take(X, 0, r), take(M, 0, r), take(Cn, 0, r), take(Yi, 0, r), take(Yd, 0, r), ni, nd), [docent_body, docent_head_i, docent_head_d], lr, 0.9, 0.999, 0.00000001)
    };
    i = i + 1
  };
  train_ms = train_ms + (clock_ms() - ts);
  e = e + 1;
  if eq(mod(e, every), 0) {
    et = u:docent_eval_t(X, M, Cn, Yi, Yd, train_rows, ni, nd);
    ev = u:docent_eval_t(X, M, Cn, Yi, Yd, val_rows, ni, nd);
    curve_t = concat(curve_t, et.loss);
    curve_v = concat(curve_v, ev.loss);
    curve_d = concat(curve_d, ev.dest_acc);
    print("epoch", e, variant, "train loss", u:svg_round(et.loss, 4), "val loss", u:svg_round(ev.loss, 4), "val intent acc", u:svg_round(ev.intent_acc, 3), "val dest acc", u:svg_round(ev.dest_acc, 3))
  } else {
    0
  }
};
run = {curve_t: curve_t, curve_v: curve_v, curve_d: curve_d, train_ms: train_ms};
mres = u:measure(variant);

def u:row_for(lesson, config, mres, run) {
  "A docent results row for one variant.";
  {lesson: lesson, config: config, binary: binary, params: params, active_params: round(reduce_add(Cn) / k.n * dm + p_body + p_heads), bytes_f64: params * 8, bytes_int8: params, ms_per_query: u:svg_round(mres.ms, 4), train_loss: u:svg_round(mres.et.loss, 4), val_loss: u:svg_round(mres.ev.loss, 4), intent_acc: u:svg_round(mres.ev.intent_acc, 3), dest_acc: u:svg_round(mres.ev.dest_acc, 3), top3_acc: u:svg_round(mres.ev.top3_acc, 3), exhibit_acc: u:svg_round(mres.exhibit_acc, 3), ambiguous_top2: u:svg_round(mres.amb, 3), unsupported_recall: u:svg_round(mres.unsupported_recall, 3), paraphrase_acc: u:svg_round(mres.pv.dest_acc, 3), paraphrase_intent_acc: u:svg_round(mres.pv.intent_acc, 3), expert_evals: 0}
}

row = if fine_tune {
  u:row_for("CD01b", str_concat(str_concat("docent dense over word vectors (PPMI rank-24 on docs-a.txt, ", to_string(vocab.size)), " words) in a 1024-slot table, fine-tuned; corpus A, 40 ep, lr 0.003; one process per variant"), mres, run)
} else {
  u:row_for("CD01bf", "the same with the table frozen: only the body and heads train; one process per variant", mres, run)
};
w_rows = write_atomic(str_concat(str_concat(out_dir, "/results-row-"), str_concat(variant, ".md")), str_concat(u:docent_row(row), "\n"));
metrics = {variant: variant, curve_t: run.curve_t, curve_v: run.curve_v, curve_d: run.curve_d, dest_acc: mres.ev.dest_acc, paraphrase_acc: mres.pv.dest_acc, filled: tb.filled, collisions: tb.collisions, apl_row: u:domain_slice(take(tb.table, 0, u:docent_slot("apl", S)), 0, 8), cosmac_row: u:domain_slice(take(tb.table, 0, u:docent_slot("cosmac", S)), 0, 8)};
w_metrics = write_atomic(str_concat(str_concat(out_dir, "/metrics-"), str_concat(variant, ".json")), unwrap(to_json(metrics)));

def u:top_words(n) {
  "Indices of the n vocabulary words with the largest PPMI row sums.";
  argtop_k(reduce_add(P, 1), n)
}

def u:cooccurrence_svg() {
  "Diagram: PPMI among the sixteen strongest words and the counting rule.";
  top = u:top_words(16);
  sub = gather_rows(transpose(gather_rows(P, top)), top);
  mx = reduce(:max, sub) + 0.0001;
  page = u:svg_head("Word co-occurrence and PPMI from the campus text", "Positive pointwise mutual information among the sixteen vocabulary words with the largest PPMI row sums, from sentence-bounded co-occurrence counts over a window of four in the campus's own text.");
  page = str_concat(page, u:svg_text(32, 36, "h", "CO-OCCURRENCE -- what the campus text says goes together"));
  page = str_concat(page, u:svg_text(32, 60, "m", str_concat(str_concat(str_concat("WHAT: ", to_string(vocab.size)), " vocabulary words from "), str_concat(str_concat(to_string(vocab.tokens), " content tokens ("), str_concat(to_string(docs_bytes), " bytes of text): counts within four words in a sentence, then PPMI.")))));
  page = str_concat(page, u:svg_heat(sub / mx, 260, 84, 26));
  i = 0;
  while lt(i, 16) {
    page = str_concat(page, u:svg_text(120, 102 + i * 26, "s", u:lg(vocab.words, take(top, 0, i))));
    page = str_concat(page, u:svg_text(262 + i * 26, 80, "s", str_slice(u:lg(vocab.words, take(top, 0, i)), 0, 3)));
    i = i + 1
  };
  page = str_concat(page, u:svg_text(700, 110, "k", "HOW"));
  page = str_concat(page, u:svg_text(700, 132, "", "one_hot(ids) gives O [N, V];"));
  page = str_concat(page, u:svg_text(700, 152, "", "for d in 1..4: C += O[:-d]' O[d:]"));
  page = str_concat(page, u:svg_text(700, 172, "", "masked to the same sentence,"));
  page = str_concat(page, u:svg_text(700, 192, "", "plus the transpose; then"));
  page = str_concat(page, u:svg_text(700, 212, "", "PPMI = relu(log(P(a,b) / P(a)P(b)))."));
  page = str_concat(page, u:svg_text(700, 244, "k", "WHY"));
  page = str_concat(page, u:svg_text(700, 266, "", "Words that share sentences in"));
  page = str_concat(page, u:svg_text(700, 286, "", "the campus's own text should"));
  page = str_concat(page, u:svg_text(700, 306, "", "end up near each other, so a"));
  page = str_concat(page, u:svg_text(700, 326, "", "paraphrase can reach a place"));
  page = str_concat(page, u:svg_text(700, 346, "", "through words no alias holds."));
  page = str_concat(page, u:svg_text(700, 378, "m", "No external data: stories,"));
  page = str_concat(page, u:svg_text(700, 398, "m", "status lines, taglines, and the"));
  page = str_concat(page, u:svg_text(700, 418, "m", "linked repositories' READMEs."));
  page = str_concat(page, u:svg_text(40, 520, "m", "Shading is PPMI over the block maximum; row labels are the words, column labels their first three letters."));
  str_concat(page, "</svg>")
}

def u:neighbours_svg() {
  "Diagram: the factorization and nearest neighbours of probe words.";
  page = u:svg_head("Word vectors: factorization and nearest neighbours", "Rank-24 vectors from five orthogonal iterations over the PPMI matrix, and the five nearest vocabulary words of eight probe words by cosine similarity.");
  page = str_concat(page, u:svg_text(32, 36, "h", "WORD VECTORS -- rank-24 by orthogonal iteration, nearest neighbours"));
  page = str_concat(page, u:svg_text(32, 60, "m", "WHAT: Q = orthonormalize(random [V, 24]); repeat five times Q = orthonormalize(P Q); vectors = rows of P Q, unit length."));
  i = 0;
  while lt(i, 8) {
    page = str_concat(page, u:svg_text(40, 96 + i * 24, "", u:neighbour_line(u:lg(probe_words, i), 5)));
    i = i + 1
  };
  page = str_concat(page, u:svg_rect(30, 300, 900, 220, "panel"));
  page = str_concat(page, u:svg_text(50, 328, "", "WHY: orthogonal iteration is power iteration for several vectors at once; with Gram-Schmidt between steps the columns"));
  page = str_concat(page, u:svg_text(50, 350, "", "     converge to the leading eigenvectors of the symmetric PPMI matrix, the same subspace a truncated SVD would give."));
  page = str_concat(page, u:svg_text(50, 376, "", "HOW: u:wv_orthonormalize is Gram-Schmidt over columns (concat on axis 1); u:wv_factor multiplies by P and re-orthonormalizes;"));
  page = str_concat(page, u:svg_text(50, 398, "", "     u:wv_neighbours ranks cosine similarities with argtop_k, the word itself excluded. Everything is deterministic (seeded)."));
  page = str_concat(page, u:svg_text(50, 424, "", "WHY IT MAY NOT BE ENOUGH: a few thousand tokens give noisy neighbours; words seen once have no vector at all, and"));
  page = str_concat(page, u:svg_text(50, 446, "", "     hashing 586 words into 1,024 rows makes some share a row. The paraphrase columns decide, not the neighbour lists."));
  page = str_concat(page, u:svg_text(50, 476, "m", "Numbers: docent results table rows CD01b (fine-tuned) and CD01bf (frozen) beside CD01, MB01, and MB01t."));
  str_concat(page, "</svg>")
}


w1 = if fine_tune {
  write_atomic(str_concat(out_dir, "/wordvec-cooccurrence.svg"), u:cooccurrence_svg())
} else {
  ok(0)
};
w2 = if fine_tune {
  write_atomic(str_concat(out_dir, "/wordvec-neighbours.svg"), u:neighbours_svg())
} else {
  ok(0)
};
print("MEMORY -- params", params, "(table", p_table, "); docs bytes", docs_bytes, "; vocabulary", vocab.size, "; table filled", tb.filled, "collisions", tb.collisions);
print("SPEED -- vectors ms", u:svg_round(vectors_ms, 0), variant, "train ms", u:svg_round(run.train_ms, 0), "ms/query", u:svg_round(mres.ms, 4), "(", binary, ")");
