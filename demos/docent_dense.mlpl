# CD01 docent dense classifier: hashed word and bigram features pooled into an embedding, one hidden layer, intent and destination heads, trained in batch on corpus A and measured on the held-out rows.
include "../lib/docent.mlpl";
include "../lib/svg.mlpl";

print("WHAT THIS SHOWS -- How a query becomes hashed feature slots, how their pooled embedding feeds an intent head and a destination head, and how well the flat classifier does on held-out rows.");
print("SHAPES -- features ids/mask:[N,24], embedding:[512,24], pooled:[1,24], hidden:[1,32], intent logits:[1,6], destination logits:[1,13].");

out_dir = unwrap(list_get(args(), 0));
binary = unwrap(list_get(args(), 1));
c = u:campus_load("fixtures/campus/snapshot-a.json");
k = unwrap(parse_json(unwrap(read_text("fixtures/campus/corpus-a.json"))));
S = 1024;
F = u:docent_max_features();
dm = 24;
hd = 32;
ni = 6;
dest_names = u:dest_names(c);
nd = list_len(dest_names);
lr = 0.003;
epochs = 40;
every = 5;

t_feat = clock_ms();
feat = u:docent_matrix(k.queries, S);
feat_ms = clock_ms() - t_feat;
X = feat.ids;
M = feat.mask;
Cn = feat.counts;
lab = u:docent_labels(c, k.intents, k.dests);
Yi = lab.yi;
Yd = lab.yd;
member = k.train;
train_rows = compress(member, range(k.n));
val_rows = compress(1 - member, range(k.n));
ntrain = reduce_mul(shape(train_rows));
nval = reduce_mul(shape(val_rows));
used = fill([S], 0);
i = 0;
while lt(i, k.n * F) {
  used = if take(reshape(M, [k.n * F]), 0, i) {
    scatter(used, take(reshape(X, [k.n * F]), 0, i), 1)
  } else {
    used
  };
  i = i + 1
};
slots_used = reduce_add(used);

docent_emb = embed(S, dm, 1);
docent_body = chain(linear(dm, hd, 2), relu_layer());
docent_head_i = linear(hd, ni, 3);
docent_head_d = linear(hd, nd, 4);
p_emb = param_count(docent_emb);
p_body = param_count(docent_body);
p_hi = param_count(docent_head_i);
p_hd = param_count(docent_head_d);
params = p_emb + p_body + p_hi + p_hd;
mean_features = reduce_add(Cn) / k.n;
active = round(mean_features * dm + p_body + p_hi + p_hd);
print("MODEL -- params", params, "of which embedding", p_emb, "body", p_body, "heads", p_hi + p_hd, "; active per query (mean", u:svg_round(mean_features, 2), "features)", active, "; slots used", slots_used, "of", S);

curve_e = fill([0], 0);
curve_t = fill([0], 0);
curve_v = fill([0], 0);
curve_i = fill([0], 0);
curve_d = fill([0], 0);
train_ms = 0;
e = 0;
while lt(e, epochs) {
  ts = clock_ms();
  i = 0;
  while lt(i, ntrain) {
    r = take(train_rows, 0, i);
    adam(u:docent_loss(take(X, 0, r), take(M, 0, r), take(Cn, 0, r), take(Yi, 0, r), take(Yd, 0, r), ni, nd), [docent_emb, docent_body, docent_head_i, docent_head_d], lr, 0.9, 0.999, 0.00000001);
    i = i + 1
  };
  train_ms = train_ms + (clock_ms() - ts);
  e = e + 1;
  if eq(mod(e, every), 0) {
    et = u:docent_eval(X, M, Cn, Yi, Yd, train_rows, ni, nd);
    ev = u:docent_eval(X, M, Cn, Yi, Yd, val_rows, ni, nd);
    tl = emit_frame("docent/loss/train", e, et.loss);
    vl = emit_frame("docent/loss/val", e, ev.loss);
    ai = emit_frame("docent/acc/intent", e, ev.intent_acc);
    ad = emit_frame("docent/acc/dest", e, ev.dest_acc);
    curve_e = concat(curve_e, e);
    curve_t = concat(curve_t, tl);
    curve_v = concat(curve_v, vl);
    curve_i = concat(curve_i, ai);
    curve_d = concat(curve_d, ad);
    print("epoch", e, "train loss", u:svg_round(tl, 4), "val loss", u:svg_round(vl, 4), "val intent acc", u:svg_round(ai, 3), "val dest acc", u:svg_round(ad, 3))
  } else {
    0
  }
};

t_eval = clock_ms();
ev = u:docent_eval(X, M, Cn, Yi, Yd, val_rows, ni, nd);
eval_ms = clock_ms() - t_eval;
ms_per_query = eval_ms / nval;
et = u:docent_eval(X, M, Cn, Yi, Yd, train_rows, ni, nd);
yi_val = reshape(gather_rows(reshape(Yi, [k.n, 1]), val_rows), [nval]);
yd_val = reshape(gather_rows(reshape(Yd, [k.n, 1]), val_rows), [nval]);
ex_ids = [u:dest_index(c, "ibm-1130-emulator"), u:dest_index(c, "rca-1802"), u:dest_index(c, "apl")];
exhibit_sel = eq(yd_val, take(ex_ids, 0, 0)) + eq(yd_val, take(ex_ids, 0, 1)) + eq(yd_val, take(ex_ids, 0, 2));
exhibit_acc = reduce_add(ev.hit_d * exhibit_sel) / reduce_add(exhibit_sel);
unsupported_recall = u:acc_where(ev.hit_i, yi_val, u:intent_index("unsupported"));
confusion = emit_frame("docent/confusion/val", epochs, u:confusion(yd_val, ev.pred_d, nd));

amb_rows = fill([0], 0);
amb_a = fill([0], 0);
amb_b = fill([0], 0);
j = 0;
i = 0;
while lt(i, k.n) {
  is_amb = str_eq(u:lg(k.kinds, i), "ambiguous");
  amb_rows = if is_amb {
    concat(amb_rows, i)
  } else {
    amb_rows
  };
  pair = if is_amb {
    str_split(u:lg(c.ambiguous_dests, j), ",")
  } else {
    str_split("none,none", ",")
  };
  amb_a = if is_amb {
    concat(amb_a, u:dest_index(c, u:lg(pair, 0)))
  } else {
    amb_a
  };
  amb_b = if is_amb {
    concat(amb_b, u:dest_index(c, u:lg(pair, 1)))
  } else {
    amb_b
  };
  j = j + is_amb;
  i = i + 1
};
ambiguous_top2 = u:top2_set_hits(X, M, Cn, amb_rows, amb_a, amb_b, nd);
pp = unwrap(parse_json(unwrap(read_text("fixtures/campus/paraphrases-a.json"))));
pfeat = u:docent_matrix(pp.queries, S);
plab = u:docent_labels(c, pp.intents, pp.dests);
np_rows = list_len(pp.queries);
PX = pfeat.ids;
PM = pfeat.mask;
PC = pfeat.counts;
PYi = plab.yi;
PYd = plab.yd;
pev = u:docent_eval(PX, PM, PC, PYi, PYd, range(np_rows), ni, nd);
paraphrase_acc = pev.dest_acc;
paraphrase_intent_acc = pev.intent_acc;

def u:first_row(kind, in_val) {
  "Index of the first corpus row of a kind, restricted to validation rows when in_val is one.";
  found = -1;
  i = 0;
  while lt(i, k.n) {
    ok_row = str_eq(u:lg(k.kinds, i), kind) * gt(1 - in_val + (1 - take(member, 0, i)), 0) * lt(found, 0);
    found = if ok_row {
      i
    } else {
      found
    };
    i = i + 1
  };
  found
}

def u:describe(r) {
  "One decoded line for corpus row r: query, true labels, predicted intent and destination with the top-3 destinations.";
  lg = u:docent_logits(take(X, 0, r), take(M, 0, r), take(Cn, 0, r));
  pi = argmax(lg.intent);
  pd = argmax(lg.dest);
  pr = softmax(reshape(lg.dest, [nd]));
  top3 = argtop_k(reshape(lg.dest, [nd]), 3);
  t1 = take(top3, 0, 0);
  t2 = take(top3, 0, 1);
  line = str_concat(str_concat("\"", u:lg(k.queries, r)), "\"  -> ");
  line = str_concat(line, str_concat(str_concat(u:lg(u:intent_names(), pi), " / "), u:lg(dest_names, pd)));
  line = str_concat(line, str_concat(str_concat(" (", to_string(u:svg_round(take(pr, 0, t1), 2))), str_concat(str_concat("), then ", u:lg(dest_names, t2)), str_concat(str_concat(" (", to_string(u:svg_round(take(pr, 0, t2), 2))), ")"))));
  str_concat(line, str_concat(str_concat("  [true: ", u:lg(k.intents, r)), str_concat(str_concat(" / ", u:lg(k.dests, r)), "]")))
}

row_auth = u:first_row("authored", 1);
row_amb = u:first_row("ambiguous", 0);
row_uns = u:first_row("unsupported", 1);
example = "where is the cosmac demo";
ex = u:docent_features(example, S);
ex_words = str_split(example, " ");
ex_rows = apply(docent_emb, ex.ids);
ex_pooled = u:docent_pooled(ex.ids, ex.mask, ex.n);
ex_lg = u:docent_logits(ex.ids, ex.mask, ex.n);
ex_pi = softmax(reshape(ex_lg.intent, [ni]));
ex_pd = softmax(reshape(ex_lg.dest, [nd]));
ex_top = argtop_k(reshape(ex_lg.dest, [nd]), 3);

def u:features_svg() {
  "Diagram: one query through words, bigrams, hash slots, embedding rows, and the pooled vector.";
  page = u:svg_head("Docent feature hashing data structure", "One lowercase query is split into words and adjacent bigrams; each is hashed to one of 1024 slots; the slots select rows of the learned embedding table and their mean is the query vector the heads see.");
  page = str_concat(page, u:svg_text(32, 36, "h", "FEATURE HASHING -- query to slots to pooled embedding"));
  page = str_concat(page, u:svg_text(32, 60, "m", str_concat(str_concat("WHAT: words and bigrams hashed modulo ", to_string(S)), " slots into a padded [24] id row with a mask; the pooled vector is their mean.")));
  page = str_concat(page, u:svg_text(40, 92, "k", str_concat("query   ", example)));
  page = str_concat(page, u:svg_text(40, 116, "k", "feature"));
  page = str_concat(page, u:svg_text(300, 116, "k", "slot"));
  page = str_concat(page, u:svg_text(360, 116, "k", "embedding row (first 8 of 24 dims, after training)"));
  nw = list_len(ex_words);
  i = 0;
  while lt(i, ex.n) {
    y = 138 + i * 20;
    name = if lt(i, nw) {
      u:lg(ex_words, i)
    } else {
      str_concat(str_concat(u:lg(ex_words, i - nw), "_"), u:lg(ex_words, i - nw + 1))
    };
    page = str_concat(page, u:svg_text(40, y, "", name));
    page = str_concat(page, u:svg_text(300, y, "", to_string(take(ex.ids, 0, i))));
    page = str_concat(page, u:svg_text(360, y, "m", u:svg_vec(u:domain_slice(reshape(gather_rows(ex_rows, fill([1], i)), [dm]), 0, 8), 2)));
    i = i + 1
  };
  y = 138 + ex.n * 20 + 8;
  page = str_concat(page, u:svg_text(40, y, "k", "pooled (mean)"));
  page = str_concat(page, u:svg_text(360, y, "", u:svg_vec(u:domain_slice(reshape(ex_pooled, [dm]), 0, 8), 2)));
  page = str_concat(page, u:svg_rect(30, 336, 900, 184, "panel"));
  page = str_concat(page, u:svg_text(50, 362, "", "WHY: hashed features need no tokenizer file, bound the vocabulary, and give an unseen word a slot instead of an error;"));
  page = str_concat(page, u:svg_text(50, 384, "", "     bigrams keep word order where it matters (card reader, array programming); collisions are the price, measured below."));
  page = str_concat(page, u:svg_text(50, 410, "", "HOW: u:docent_features splits on spaces, hashes each word and each adjacent pair with the base-31 checksum modulo 1024,"));
  page = str_concat(page, u:svg_text(50, 432, "", "     and pads to 24 slots with a mask; u:docent_pooled is matmul(mask, apply(embed, ids)) / n, so the mean is differentiable."));
  page = str_concat(page, u:svg_text(50, 458, "", str_concat(str_concat("Measured: ", to_string(slots_used)), str_concat(str_concat(" of ", to_string(S)), str_concat(str_concat(" slots are used by the ", to_string(k.n)), " corpus rows (collisions share a row of the table).")))));
  page = str_concat(page, u:svg_text(50, 488, "m", "Lowercase is by construction (the language has no lowercase builtin); the browser page lowercases before hashing."));
  str_concat(page, "</svg>")
}

def u:dest_prob(rank) {
  "Name and probability of the example's destination at a top-3 rank.";
  d = take(ex_top, 0, rank);
  str_concat(str_concat(u:lg(dest_names, d), " "), to_string(u:svg_round(take(ex_pd, 0, d), 3)))
}

def u:model_svg() {
  "Diagram: the stages of the dense docent with shapes and parameter counts, and the example prediction.";
  page = u:svg_head("Docent dense classifier model", "Stages from the padded feature row to the two heads with shapes and parameter counts, then the example query's intent probabilities and top-3 destinations.");
  page = str_concat(page, u:svg_text(32, 36, "h", "DENSE DOCENT -- features, pooled embedding, hidden layer, two heads"));
  page = str_concat(page, u:svg_text(32, 60, "m", str_concat(str_concat("WHAT: ", to_string(params)), str_concat(str_concat(" parameters; a query touches about ", to_string(active)), " of them (its feature rows plus the body and heads)."))));
  page = str_concat(page, u:svg_box(40, 84, 150, 64, "features", "ids [24], mask [24]", "0 params"));
  page = str_concat(page, u:svg_box(210, 84, 150, 64, "embed", "[1024, 24] table", str_concat(to_string(p_emb), " params")));
  page = str_concat(page, u:svg_box(380, 84, 150, 64, "pool", "mask . rows / n", "[1, 24]"));
  page = str_concat(page, u:svg_box(550, 84, 170, 64, "linear + relu", "[24] -> [32]", str_concat(to_string(p_body), " params")));
  page = str_concat(page, u:svg_box(740, 84, 190, 64, "heads", "intent [32] -> [6]", str_concat(str_concat("dest [32] -> [13], ", to_string(p_hi + p_hd)), " params")));
  page = str_concat(page, u:svg_text(40, 186, "k", str_concat("example  ", example)));
  page = str_concat(page, u:svg_text(40, 210, "", str_concat("intent probabilities [navigate explain recommend story status unsupported]  ", u:svg_vec(ex_pi, 3))));
  page = str_concat(page, u:svg_text(40, 234, "", str_concat("top-3 destinations  ", str_concat(str_concat(u:dest_prob(0), "   "), str_concat(str_concat(u:dest_prob(1), "   "), u:dest_prob(2))))));
  page = str_concat(page, u:svg_text(40, 258, "m", "The catalog then supplies the title, breadcrumb, URL, and story for the predicted place; the model never emits text."));
  page = str_concat(page, u:svg_rect(30, 290, 900, 230, "panel"));
  page = str_concat(page, u:svg_text(50, 318, "", "WHY: the model predicts meaning only (an intent and a destination distribution); the campus catalog stays the authority"));
  page = str_concat(page, u:svg_text(50, 340, "", "     for facts, so a stale model can never invent an exhibit, and a wrong pick is a wrong link rather than a false sentence."));
  page = str_concat(page, u:svg_text(50, 366, "", "WHY: a flat dense classifier is the baseline every routed docent (CD02, CD03) is measured against for the same corpus."));
  page = str_concat(page, u:svg_text(50, 392, "", "HOW: embed(1024, 24), chain(linear(24, 32), relu_layer()), linear(32, 6), linear(32, 13); loss = intent CE + destination CE;"));
  page = str_concat(page, u:svg_text(50, 414, "", "     one adam step per training row per epoch (lr 0.003, 40 epochs); u:docent_loss inlines through the tape (finding F2)."));
  page = str_concat(page, u:svg_text(50, 440, "", str_concat(str_concat("Bytes: ", to_string(params * 8)), str_concat(str_concat(" at f64, ", to_string(params)), " at INT8 (payload, projected); the export of step 4 measures the real file."))));
  page = str_concat(page, u:svg_text(50, 470, "m", "Models are globals (finding F7: a model cannot be a user-function argument); the library names them docent_emb and so on."));
  page = str_concat(page, u:svg_text(50, 494, "m", "Train, validation, and timing numbers are in the docent results table, never drawn here, so this diagram stays byte-stable."));
  str_concat(page, "</svg>")
}

def u:curve_xs(es) {
  "Epoch values mapped to pixel x positions in the curve panel.";
  60 + es * (340 / epochs)
}

def u:run_svg() {
  "Diagram: loss and accuracy curves, the validation confusion matrix by destination, and three decoded queries.";
  page = u:svg_head("Docent dense classifier run", "Training and validation loss every five epochs, held-out intent and destination accuracy, the validation confusion matrix over destinations, and three decoded queries: an authored one, an ambiguous one, and an unsupported one.");
  page = str_concat(page, u:svg_text(32, 36, "h", "DENSE DOCENT RUN -- loss, accuracy, confusion, decoded queries"));
  page = str_concat(page, u:svg_text(40, 66, "k", "loss (train amber, val pink)"));
  page = str_concat(page, u:svg_rect(60, 76, 340, 110, "cell"));
  vmax = reduce(:max, concat(curve_t, curve_v)) + 0.0001;
  page = str_concat(page, u:svg_polyline(u:curve_xs(curve_e), 186 - curve_t * (105 / vmax), "l1"));
  page = str_concat(page, u:svg_polyline(u:curve_xs(curve_e), 186 - curve_v * (105 / vmax), "l2"));
  page = str_concat(page, u:svg_text(60, 200, "s", str_concat(str_concat("0 .. ", to_string(epochs)), str_concat(" epochs; max ", to_string(u:svg_round(vmax, 2))))));
  page = str_concat(page, u:svg_text(40, 226, "k", "held-out accuracy (intent blue, destination violet)"));
  page = str_concat(page, u:svg_rect(60, 236, 340, 110, "cell"));
  page = str_concat(page, u:svg_polyline(u:curve_xs(curve_e), 346 - curve_i * 105, "l3"));
  page = str_concat(page, u:svg_polyline(u:curve_xs(curve_e), 346 - curve_d * 105, "l4"));
  page = str_concat(page, u:svg_text(60, 360, "s", "0 .. 1; the usefulness bar is 0.9 for both"));
  page = str_concat(page, u:svg_text(440, 66, "k", "validation confusion by destination (rows true, cols predicted)"));
  rowsum = reduce_add(confusion, 1) + eq(reduce_add(confusion, 1), 0);
  norm = confusion / reshape(rowsum, [nd, 1]);
  page = str_concat(page, u:svg_heat(norm, 600, 76, 25));
  i = 0;
  while lt(i, nd) {
    page = str_concat(page, u:svg_text(440, 92 + i * 25, "s", u:lg(dest_names, i)));
    i = i + 1
  };
  page = str_concat(page, u:svg_text(40, 458, "k", "decoded held-out queries"));
  page = str_concat(page, u:svg_text(40, 478, "", u:describe(row_auth)));
  page = str_concat(page, u:svg_text(40, 496, "", u:describe(row_amb)));
  page = str_concat(page, u:svg_text(40, 514, "", u:describe(row_uns)));
  page = str_concat(page, u:svg_text(40, 534, "m", "HOW: u:docent_eval decodes every row with argmax on both heads and argtop_k; numbers are in docent-results.md."));
  str_concat(page, "</svg>")
}

w1 = write_atomic(str_concat(out_dir, "/docent-features.svg"), u:features_svg());
w2 = write_atomic(str_concat(out_dir, "/docent-model.svg"), u:model_svg());
w3 = write_atomic(str_concat(out_dir, "/docent-run.svg"), u:run_svg());

row = {lesson: "CD01", config: "docent dense S1024 F24 d24 h32 relu, corpus A train rows, 40 ep, lr 0.003, per-row adam", binary: binary, params: params, active_params: active, bytes_f64: params * 8, bytes_int8: params, ms_per_query: u:svg_round(ms_per_query, 4), train_loss: u:svg_round(et.loss, 4), val_loss: u:svg_round(ev.loss, 4), intent_acc: u:svg_round(ev.intent_acc, 3), dest_acc: u:svg_round(ev.dest_acc, 3), top3_acc: u:svg_round(ev.top3_acc, 3), exhibit_acc: u:svg_round(exhibit_acc, 3), ambiguous_top2: u:svg_round(ambiguous_top2, 3), unsupported_recall: u:svg_round(unsupported_recall, 3), paraphrase_acc: u:svg_round(paraphrase_acc, 3), paraphrase_intent_acc: u:svg_round(paraphrase_intent_acc, 3), expert_evals: 0};
w4 = write_atomic(str_concat(out_dir, "/results-row.md"), str_concat(u:docent_row(row), "\n"));

print("MEMORY -- params", params, "active/query", active, "bytes f64", params * 8, "bytes int8", params, "slots used", slots_used);
print("SPEED -- train ms", u:svg_round(train_ms, 0), "ms/step", u:svg_round(train_ms / (epochs * ntrain), 4), "ms/query (inference)", u:svg_round(ms_per_query, 4), "(", binary, ")");
print("QUALITY -- val loss", u:svg_round(ev.loss, 4), "intent acc", u:svg_round(ev.intent_acc, 3), "dest acc", u:svg_round(ev.dest_acc, 3), "top-3", u:svg_round(ev.top3_acc, 3), "exhibit acc", u:svg_round(exhibit_acc, 3), "ambiguous top-2", u:svg_round(ambiguous_top2, 3), "unsupported recall", u:svg_round(unsupported_recall, 3), "paraphrase dest/intent", u:svg_round(paraphrase_acc, 3), u:svg_round(paraphrase_intent_acc, 3), "train acc intent/dest", u:svg_round(et.intent_acc, 3), u:svg_round(et.dest_acc, 3));
