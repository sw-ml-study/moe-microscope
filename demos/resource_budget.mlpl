# RB01 resource-budget microscope: no training; stored, resident, active, and transferred bytes for the committed models, expert size statistics, dtype projections, residency scenarios, and transfer estimates, every number labeled M, D, or E.
include "../lib/budget.mlpl";
include "../lib/results.mlpl";
include "../lib/svg.mlpl";

print("WHAT THIS SHOWS -- How big MicroMoE is: what is stored, what one token touches, what an expert costs, and what quantization and a bounded cache would change.");
print("LEGEND -- M measured directly, D derived from measured values, E estimate or scenario assumption.");

out_dir = if list_len(args()) {
  unwrap(list_get(args(), 0))
} else {
  ""
};
writing = str_len(out_dir);
V = 52;
T = 28;
cfg_dn = u:budget_config(16, 32, V, 0, 0, 1, 0, T);
cfg_mx1 = u:budget_config(16, 32, V, 4, 1, 0, 0, T);
cfg_mx2 = u:budget_config(16, 32, V, 4, 2, 0, 0, T);
cfg_ld = u:budget_config(16, 32, V, 16, 1, 1, 4, T);
t_dn = u:budget_totals(cfg_dn);
t_mx1 = u:budget_totals(cfg_mx1);
t_mx2 = u:budget_totals(cfg_mx2);
t_ld = u:budget_totals(cfg_ld);
r_dn = unwrap(u:results_lookup("docs/reference/results.md", "DN01"));
r_mx1 = unwrap(u:results_lookup("docs/reference/results.md", "MX01"));
r_mx2 = unwrap(u:results_lookup("docs/reference/results.md", "MX02"));
r_ld = unwrap(u:results_lookup("docs/reference/results.md", "LD01"));
r_sd = unwrap(u:results_lookup("docs/reference/results.md", "SD01"));

def u:kib(bytes) {
  "Bytes as KiB with one decimal.";
  u:svg_round(bytes / 1024, 1)
}

def u:agree(label, calc, measured) {
  "Fail loudly when the calculator disagrees with a measured results cell.";
  if eq(calc, measured) {
    0
  } else {
    print("MISMATCH --", label, "calculator", calc, "measured", measured);
    1
  }
}

mismatch = u:agree("DN01 params", t_dn.stored, r_dn.params) + u:agree("MX01 params", t_mx1.stored, r_mx1.params) + u:agree("MX01 active", t_mx1.active, r_mx1.active_params) + u:agree("MX02 active", t_mx2.active, r_mx2.active_params) + u:agree("LD01 params", t_ld.stored, r_ld.params) + u:agree("SD01 bytes/expert", t_mx1.per_expert * 8, r_sd.bytes_per_expert);

full_stats = u:budget_expert_stats(fill([4], t_mx1.per_expert * 8));
delta_stats = u:budget_expert_stats(fill([16], t_ld.per_expert * 8));
proj_full = u:budget_projection(t_mx1.per_expert);
proj_mx = u:budget_projection(t_mx1.stored);
proj_dn = u:budget_projection(t_dn.stored);
proj_ld = u:budget_projection(t_ld.stored);
mixed_mx = (t_mx1.stored - t_mx1.bank) * 1 + t_mx1.bank / 2;

res_now = u:budget_residency(cfg_mx1, 8, 4, 0, 0);
res_cache2 = u:budget_residency(cfg_mx1, 8, 2, 0, 0);
res_lab = u:budget_residency(u:budget_config(256, 128, 4096, 64, 2, 1, 0, 128), 1, 8, 65536, 32);
res_lab_int4 = u:budget_residency(u:budget_config(256, 128, 4096, 64, 2, 1, 0, 128), 0.5, 8, 65536, 32);
res_bank256 = u:budget_residency(u:budget_config(16, 32, V, 256, 1, 0, 0, T), 0.5, 8, 0, 0);
bank256 = u:budget_totals(u:budget_config(16, 32, V, 256, 1, 0, 0, T));

hdd = [u:budget_transfer_ms(8576, 8000, 150), u:budget_transfer_ms(1072, 8000, 150), u:budget_transfer_ms(536, 8000, 150)];
ssd = [u:budget_transfer_ms(8576, 80, 500), u:budget_transfer_ms(1072, 80, 500), u:budget_transfer_ms(536, 80, 500)];
nvme = [u:budget_transfer_ms(8576, 20, 3000), u:budget_transfer_ms(1072, 20, 3000), u:budget_transfer_ms(536, 20, 3000)];
ram = [u:budget_transfer_ms(8576, 0.1, 20000), u:budget_transfer_ms(1072, 0.1, 20000), u:budget_transfer_ms(536, 0.1, 20000)];

def u:row(cells) {
  "A markdown table row from a string list.";
  str_concat(str_concat("| ", str_join(cells, " | ")), " |")
}

def u:n(v) {
  "Number as text.";
  to_string(v)
}

def u:budget_markdown() {
  "The resource-budget document: model sizes, expert cost, dtype projections, residency scenarios, transfer estimates, and the calculator's own checks.";
  lines = [
    "# Resource budget (RB01)",
    "",
    "Generated by `demos/resource_budget.mlpl` from the committed configurations and `docs/reference/results.md`; regenerate with `just budget write`. Legend: **M** measured directly, **D** derived from measured values, **E** estimate or scenario assumption. Weights are f64 on the CPU path today, so f64 bytes are 8 times the parameter count.",
    "",
    "## 1. Model sizes today",
    "",
    u:row(["Model", "Total params [M]", "Active params/token [M]", "f64 weights [D]", "Active f64 weights/token [D]", "ms/token [M]", "Val loss [M]"]),
    "|---|---:|---:|---:|---:|---:|---:|",
    u:row(["DN01 dense", u:n(r_dn.params), u:n(r_dn.active_params), str_concat(u:n(u:kib(r_dn.params * 8)), " KiB"), str_concat(u:n(u:kib(r_dn.active_params * 8)), " KiB"), u:n(0.0205), u:n(r_dn.val_loss)]),
    u:row(["MX01 top-1 of 4", u:n(r_mx1.params), u:n(r_mx1.active_params), str_concat(u:n(u:kib(r_mx1.params * 8)), " KiB"), str_concat(u:n(u:kib(r_mx1.active_params * 8)), " KiB"), u:n(0.0462), u:n(r_mx1.val_loss)]),
    u:row(["MX02 top-2 of 4", u:n(r_mx2.params), u:n(r_mx2.active_params), str_concat(u:n(u:kib(r_mx2.params * 8)), " KiB"), str_concat(u:n(u:kib(r_mx2.active_params * 8)), " KiB"), u:n(0.0474), u:n(r_mx2.val_loss)]),
    u:row(["LD01 shared + 16 deltas", u:n(r_ld.params), u:n(r_ld.active_params), str_concat(u:n(u:kib(r_ld.params * 8)), " KiB"), str_concat(u:n(u:kib(r_ld.active_params * 8)), " KiB"), "see row", u:n(r_ld.val_loss)]),
    "",
    "ms/token values are the training-step figures from the results rows on an M1 Max with `mlpl-repl 0.22.0`; generation latency is measured separately in the generation benchmark. Top-1 stores 1.86 times DN01's parameters while touching 1.02 times as many per token; top-2 touches one more expert's worth.",
    "",
    "## 2. What an expert costs",
    "",
    u:row(["Expert form", "Params [D]", "f64 bytes [M/D]", "FP32 [E]", "FP16 [E]", "INT8 payload [E]", "INT4 payload [E]"]),
    "|---|---:|---:|---:|---:|---:|---:|",
    u:row(["full FFN 16-32-16 (MX01, MX02)", u:n(t_mx1.per_expert), u:n(take(proj_full, 0, 0)), u:n(take(proj_full, 0, 1)), u:n(take(proj_full, 0, 2)), u:n(take(proj_full, 0, 3)), u:n(take(proj_full, 0, 4))]),
    u:row(["rank-4 delta over width 16 (LD01)", u:n(t_ld.per_expert), u:n(t_ld.per_expert * 8), u:n(t_ld.per_expert * 4), u:n(t_ld.per_expert * 2), u:n(t_ld.per_expert), u:n(t_ld.per_expert / 2)]),
    "",
    str_concat("Expert size statistics over the MX01 bank [D]: count ", str_concat(u:n(full_stats.count), str_concat(", min ", str_concat(u:n(full_stats.min), str_concat(", mean ", str_concat(u:n(full_stats.mean), str_concat(", median ", str_concat(u:n(full_stats.median), str_concat(", p90 ", str_concat(u:n(full_stats.p90), str_concat(", max ", str_concat(u:n(full_stats.max), str_concat(", total ", str_concat(u:n(full_stats.total), " bytes at f64. Experts are uniform today; the statistics exist so that heterogeneous experts and byte-budgeted caches can be compared later.")))))))))))))),
    str_concat("Over the LD01 bank [D]: count ", str_concat(u:n(delta_stats.count), str_concat(", each ", str_concat(u:n(delta_stats.mean), str_concat(" bytes, total ", str_concat(u:n(delta_stats.total), " bytes at f64.")))))),
    "",
    "## 3. Stored versus active per token",
    "",
    u:row(["Model", "Stored f64 [D]", "Active f64/token [D]", "Stored / active [D]", "Expert bank share of stored [D]"]),
    "|---|---:|---:|---:|---:|",
    u:row(["DN01", str_concat(u:n(u:kib(t_dn.stored * 8)), " KiB"), str_concat(u:n(u:kib(t_dn.active * 8)), " KiB"), u:n(u:svg_round(t_dn.stored / t_dn.active, 2)), "0%"]),
    u:row(["MX01", str_concat(u:n(u:kib(t_mx1.stored * 8)), " KiB"), str_concat(u:n(u:kib(t_mx1.active * 8)), " KiB"), u:n(u:svg_round(t_mx1.stored / t_mx1.active, 2)), str_concat(u:n(round(100 * t_mx1.bank / t_mx1.stored)), "%")]),
    u:row(["MX02", str_concat(u:n(u:kib(t_mx2.stored * 8)), " KiB"), str_concat(u:n(u:kib(t_mx2.active * 8)), " KiB"), u:n(u:svg_round(t_mx2.stored / t_mx2.active, 2)), str_concat(u:n(round(100 * t_mx2.bank / t_mx2.stored)), "%")]),
    u:row(["LD01", str_concat(u:n(u:kib(t_ld.stored * 8)), " KiB"), str_concat(u:n(u:kib(t_ld.active * 8)), " KiB"), u:n(u:svg_round(t_ld.stored / t_ld.active, 2)), str_concat(u:n(round(100 * t_ld.bank / t_ld.stored)), "%")]),
    "",
    "## 4. Quantization projections [E]",
    "",
    "Payload only: no scales, headers, alignment, or index. QZ01 and PK01 will replace these with measured file sizes.",
    "",
    u:row(["Weights", "FP64", "FP32", "FP16", "INT8", "INT4", "INT8 shared + INT4 experts"]),
    "|---|---:|---:|---:|---:|---:|---:|",
    u:row(["DN01", str_concat(u:n(u:kib(take(proj_dn, 0, 0))), " KiB"), str_concat(u:n(u:kib(take(proj_dn, 0, 1))), " KiB"), str_concat(u:n(u:kib(take(proj_dn, 0, 2))), " KiB"), str_concat(u:n(u:kib(take(proj_dn, 0, 3))), " KiB"), str_concat(u:n(u:kib(take(proj_dn, 0, 4))), " KiB"), "-"]),
    u:row(["MX01 / MX02", str_concat(u:n(u:kib(take(proj_mx, 0, 0))), " KiB"), str_concat(u:n(u:kib(take(proj_mx, 0, 1))), " KiB"), str_concat(u:n(u:kib(take(proj_mx, 0, 2))), " KiB"), str_concat(u:n(u:kib(take(proj_mx, 0, 3))), " KiB"), str_concat(u:n(u:kib(take(proj_mx, 0, 4))), " KiB"), str_concat(u:n(u:kib(mixed_mx)), " KiB")]),
    u:row(["LD01", str_concat(u:n(u:kib(take(proj_ld, 0, 0))), " KiB"), str_concat(u:n(u:kib(take(proj_ld, 0, 1))), " KiB"), str_concat(u:n(u:kib(take(proj_ld, 0, 2))), " KiB"), str_concat(u:n(u:kib(take(proj_ld, 0, 3))), " KiB"), str_concat(u:n(u:kib(take(proj_ld, 0, 4))), " KiB"), "-"]),
    "",
    "## 5. Residency scenarios [E]",
    "",
    "The calculator's stored, resident, and active bytes for the current model with a bounded expert cache, for a 256-expert systems experiment with the same tiny expert, and for the lab-scale configuration from the plan (d_model 256, 64 experts top-2, one shared expert, 65,536 by 32 Engram).",
    "",
    u:row(["Scenario", "Stored", "Resident", "Active/token", "Stored / resident", "Resident / active"]),
    "|---|---:|---:|---:|---:|---:|",
    u:row(["MX01, all 4 experts resident, f64", str_concat(u:n(u:kib(res_now.stored)), " KiB"), str_concat(u:n(u:kib(res_now.resident)), " KiB"), str_concat(u:n(u:kib(res_now.active)), " KiB"), u:n(u:svg_round(res_now.storage_to_resident, 2)), u:n(u:svg_round(res_now.resident_to_active, 2))]),
    u:row(["MX01, 2-expert cache, f64", str_concat(u:n(u:kib(res_cache2.stored)), " KiB"), str_concat(u:n(u:kib(res_cache2.resident)), " KiB"), str_concat(u:n(u:kib(res_cache2.active)), " KiB"), u:n(u:svg_round(res_cache2.storage_to_resident, 2)), u:n(u:svg_round(res_cache2.resident_to_active, 2))]),
    u:row(["256 experts top-1, 8-expert cache, INT4", str_concat(u:n(u:kib(res_bank256.stored)), " KiB"), str_concat(u:n(u:kib(res_bank256.resident)), " KiB"), str_concat(u:n(u:kib(res_bank256.active)), " KiB"), u:n(u:svg_round(res_bank256.storage_to_resident, 2)), u:n(u:svg_round(res_bank256.resident_to_active, 2))]),
    u:row(["lab scale, 8-expert cache, INT8", str_concat(u:n(u:svg_round(res_lab.stored / 1048576, 2)), " MiB"), str_concat(u:n(u:svg_round(res_lab.resident / 1048576, 2)), " MiB"), str_concat(u:n(u:kib(res_lab.active)), " KiB"), u:n(u:svg_round(res_lab.storage_to_resident, 2)), u:n(u:svg_round(res_lab.resident_to_active, 2))]),
    u:row(["lab scale, 8-expert cache, INT4", str_concat(u:n(u:svg_round(res_lab_int4.stored / 1048576, 2)), " MiB"), str_concat(u:n(u:svg_round(res_lab_int4.resident / 1048576, 2)), " MiB"), str_concat(u:n(u:kib(res_lab_int4.active)), " KiB"), u:n(u:svg_round(res_lab_int4.storage_to_resident, 2)), u:n(u:svg_round(res_lab_int4.resident_to_active, 2))]),
    "",
    str_concat("The 256-expert bank at f64 would be ", str_concat(u:n(u:kib(bank256.bank * 8)), " KiB of experts; caching only matters once the bank exceeds what is resident, which the current four-expert model never does. That is why TW01 will deliberately build a large bank of padded shard records.")),
    "",
    "## 6. Expert transfer estimates [E]",
    "",
    "Latency plus size over bandwidth, for assumed devices: HDD 8 ms and 150 MB/s, SATA SSD 80 us and 500 MB/s, NVMe 20 us and 3 GB/s, RAM 0.1 us and 20 GB/s. At these sizes latency dominates: an HDD miss costs hundreds of times the model's own ms/token, so a cache is about avoiding storage latency, not bytes.",
    "",
    u:row(["Device", "8,576 B f64 expert", "1,072 B INT8", "536 B INT4"]),
    "|---|---:|---:|---:|",
    u:row(["HDD", str_concat(u:n(u:svg_round(take(hdd, 0, 0), 3)), " ms"), str_concat(u:n(u:svg_round(take(hdd, 0, 1), 3)), " ms"), str_concat(u:n(u:svg_round(take(hdd, 0, 2), 3)), " ms")]),
    u:row(["SATA SSD", str_concat(u:n(u:svg_round(take(ssd, 0, 0), 4)), " ms"), str_concat(u:n(u:svg_round(take(ssd, 0, 1), 4)), " ms"), str_concat(u:n(u:svg_round(take(ssd, 0, 2), 4)), " ms")]),
    u:row(["NVMe", str_concat(u:n(u:svg_round(take(nvme, 0, 0), 4)), " ms"), str_concat(u:n(u:svg_round(take(nvme, 0, 1), 4)), " ms"), str_concat(u:n(u:svg_round(take(nvme, 0, 2), 4)), " ms")]),
    u:row(["RAM", str_concat(u:n(u:svg_round(take(ram, 0, 0), 5)), " ms"), str_concat(u:n(u:svg_round(take(ram, 0, 1), 5)), " ms"), str_concat(u:n(u:svg_round(take(ram, 0, 2), 5)), " ms")]),
    "",
    "## 7. Calculator checks",
    "",
    str_concat("The calculator (`lib/budget.mlpl`) reproduces every measured parameter count in the results table; mismatches this run: ", str_concat(u:n(mismatch), ". The same functions answer any configuration: `u:budget_config`, `u:budget_totals`, `u:budget_projection`, `u:budget_expert_stats`, `u:budget_residency`, `u:budget_transfer_ms`.")),
    ""
  ];
  str_join(lines, "\n")
}

def u:storage_svg() {
  "Diagram: proportional f64 storage bars by component for DN01, MX01, and LD01, and what one token touches under top-1 and top-2.";
  page = u:svg_head("RB01 storage layout", "Bars proportional to bytes show, for the dense model, the four-expert mixture, and the delta-expert model, how much of the stored weights are shared path versus expert bank, and how much of each a single token touches under top-1 and top-2 routing.");
  page = str_concat(page, u:svg_text(32, 36, "h", "RB01 STORAGE -- what is stored, what one token touches"));
  page = str_concat(page, u:svg_text(32, 60, "m", "WHAT: f64 bytes [D]; 900 px = 64 KiB; blue = shared path, pink = experts touched this token, grey = untouched"));
  scale = 900 / 65536;
  def u:bar(y, label, shared_b, bank_b, active_bank_b) {
    "One proportional bar: shared path, active expert bytes, inactive expert bytes.";
    out = u:svg_text(32, y - 6, "k", label);
    out = str_concat(out, u:svg_rect(32, y, shared_b * scale, 18, "tr"));
    out = str_concat(out, u:svg_rect(32 + shared_b * scale, y, active_bank_b * scale, 18, "va"));
    out = str_concat(out, u:svg_rect(32 + (shared_b + active_bank_b) * scale, y, (bank_b - active_bank_b) * scale, 18, "pad"));
    str_concat(out, u:svg_text(40 + (shared_b + bank_b) * scale, y + 14, "s", str_concat(u:svg_num(u:kib((shared_b + bank_b))), " KiB")))
  };
  page = str_concat(page, u:bar(96, "DN01 dense: shared path only (the FFN is part of it)", t_dn.stored * 8, 0, 0));
  page = str_concat(page, u:bar(146, "MX01 stored: shared path + 4 experts; top-1 touches one", (t_mx1.stored - t_mx1.bank) * 8, t_mx1.bank * 8, t_mx1.per_expert * 8));
  page = str_concat(page, u:bar(196, "MX02 stored: the same bytes; top-2 touches two", (t_mx2.stored - t_mx2.bank) * 8, t_mx2.bank * 8, 2 * t_mx2.per_expert * 8));
  page = str_concat(page, u:bar(246, "LD01 stored: shared path (with the shared FFN) + 16 deltas; top-1 touches one", (t_ld.stored - t_ld.bank) * 8, t_ld.bank * 8, t_ld.per_expert * 8));
  page = str_concat(page, u:svg_text(32, 300, "k", "active bytes per token [D]"));
  page = str_concat(page, u:svg_text(32, 322, "", str_concat("DN01 ", str_concat(u:svg_num(u:kib(t_dn.active * 8)), " KiB"))));
  page = str_concat(page, u:svg_text(232, 322, "", str_concat("MX01 ", str_concat(u:svg_num(u:kib(t_mx1.active * 8)), " KiB"))));
  page = str_concat(page, u:svg_text(432, 322, "", str_concat("MX02 ", str_concat(u:svg_num(u:kib(t_mx2.active * 8)), " KiB"))));
  page = str_concat(page, u:svg_text(632, 322, "", str_concat("LD01 ", str_concat(u:svg_num(u:kib(t_ld.active * 8)), " KiB"))));
  page = str_concat(page, u:svg_text(32, 356, "k", "one expert [M/D]: 8,576 B f64 = 4,288 B FP32 = 2,144 B FP16 = 1,072 B INT8 = 536 B INT4 payload; a rank-4 delta is 1,024 B f64"));
  page = str_concat(page, u:svg_rect(32, 366, 8576 * scale * 4, 14, "va"));
  page = str_concat(page, u:svg_rect(32, 384, 1072 * scale * 4, 14, "va"));
  page = str_concat(page, u:svg_rect(32, 402, 536 * scale * 4, 14, "va"));
  page = str_concat(page, u:svg_text(32 + 8576 * scale * 4 + 8, 378, "s", "f64 (4x scale)"));
  page = str_concat(page, u:svg_text(32 + 1072 * scale * 4 + 8, 396, "s", "INT8"));
  page = str_concat(page, u:svg_text(32 + 536 * scale * 4 + 8, 414, "s", "INT4"));
  page = str_concat(page, u:svg_rect(30, 436, 900, 100, "panel"));
  page = str_concat(page, u:svg_text(50, 460, "", "WHY: MoE promises stored capacity above active: MX01 stores 1.86x DN01 and touches 1.02x per token; top-2 adds one expert."));
  page = str_concat(page, u:svg_text(50, 482, "", "WHY: caching matters only when the bank exceeds what is resident; at 4 experts all is resident, so XC01 builds a large bank."));
  page = str_concat(page, u:svg_text(50, 504, "", "HOW: lib/budget.mlpl computes every count from a configuration, pinned to param_count of the lessons; see resource-budget.md."));
  page = str_concat(page, u:svg_text(50, 526, "m", "M measured, D derived, E estimate; no number here is a training result, so the diagram changes only when a model does."));
  str_concat(page, "</svg>")
}

r_md = if writing {
  write_atomic(str_concat(out_dir, "/resource-budget.md"), u:budget_markdown())
} else {
  ok(0)
};
r_svg = if writing {
  write_atomic(str_concat(out_dir, "/budget-storage.svg"), u:storage_svg())
} else {
  ok(0)
};
print("SIZES -- DN01", t_dn.stored, "MX01", t_mx1.stored, "MX02 active", t_mx2.active, "LD01", t_ld.stored, "; expert f64 bytes", t_mx1.per_expert * 8, "; mismatches", mismatch);
print("THE POINT -- Five quantities organize everything that follows: stored, resident, active, transferred, executed.");
if eq(mismatch, 0) * is_ok(r_md) * is_ok(r_svg) {
  ok("resource budget written")
} else {
  err("resource budget disagrees with the results table")
}
