# SS02 selective state-space block: the SS01 scan with its decay, input, and read gates computed from the token (a Mamba-like selective block), trained with the DN01 budget; one variant per process (third argument wide or matched, finding F22), with the decay per position drawn on one arithmetic and one prose window, the results row, and the comparison against SS01 and DN01.
include "../lib/ssm.mlpl";
include "../lib/observe.mlpl";
include "../lib/svg.mlpl";
include "../lib/results.mlpl";

print("WHAT THIS SHOWS -- Whether letting the token decide what the state keeps (a_t, b_t, c_t from x_t) helps where a fixed learned decay did not, and what the block chooses to forget on arithmetic against prose.");
print("SHAPES -- embedding [T,16]; gates a,b,c [T,ds] each from x; state [T,ds]; block out [T,16]; logits [T,52]; T=28 window, 120 examples, 90 train / 30 validation.");

out_dir = if list_len(args()) {
  unwrap(list_get(args(), 0))
} else {
  ""
};
binary = if gt(list_len(args()), 1) {
  unwrap(list_get(args(), 1))
} else {
  "unknown"
};
variant = if gt(list_len(args()), 2) {
  unwrap(list_get(args(), 2))
} else {
  "wide"
};
wide = str_eq(variant, "wide");
writing = str_len(out_dir);
m = unwrap(u:domain_load_mixture(u:domain_mixture_path()));
d = u:domain_build(m);
w = unwrap(u:domain_windows(d.texts, m.window));
s = u:domain_split(d.count, m.train_fraction, m.seed);
V = u:domain_vocab_size();
T = m.window;
dm = 16;
hidden = 32;
ds = if wide {
  32
} else {
  16
};
epochs = 300;
lr = 0.003;
every = 25;
ntrain = reduce_mul(shape(s.train));
nval = reduce_mul(shape(s.val));
train_x = gather_rows(w.x, s.train);
train_y = gather_rows(w.y, s.train);
train_m = gather_rows(w.mask, s.train);
val_x = gather_rows(w.x, s.val);
val_y = gather_rows(w.y, s.val);
val_m = gather_rows(w.mask, s.val);
posT = u:positions(T, dm);
config = emit_frame("ssm2/config", 0, [dm, hidden, ds, T, epochs, ntrain, nval, wide]);

emb = embed(V, dm, 0);
ssm_pre = rms_norm(dm);
sel_Wa = param[dm, ds];
sel_Wa = randn(31, [dm, ds]) * 0.2;
sel_ba = param[ds];
sel_ba = fill([ds], 2.2);
sel_Wb = param[dm, ds];
sel_Wb = randn(32, [dm, ds]) * 0.2;
sel_Wc = param[dm, ds];
sel_Wc = randn(33, [dm, ds]) * 0.2;
sel_Wo = param[ds, dm];
sel_Wo = randn(34, [ds, dm]) * 0.1;
ffn = chain(rms_norm(dm), linear(dm, hidden, 2), relu_layer(), linear(hidden, dm, 3));
norm = rms_norm(dm);
head = linear(dm, V, 4);

def u:body(h0, n) {
  "Explicit residual block (the selective scan over n positions, then the FFN), final norm, and the vocabulary head.";
  h1 = h0 + u:ssm_sel_out(apply(ssm_pre, h0), sel_Wa, sel_ba, sel_Wb, sel_Wc, sel_Wo, n, ds);
  h2 = h1 + apply(ffn, h1);
  apply(head, apply(norm, h2))
}

def u:forward(x1) {
  "Logits for one sequence of any length: embedding plus positions through the body.";
  n = reduce_mul(shape(x1));
  u:body(apply(emb, x1) + u:positions(n, dm), n)
}

p_emb = param_count(emb);
p_ssm = u:ssm_sel_params(dm, ds);
p_ffn = param_count(ffn);
p_norm = param_count(norm);
p_head = param_count(head);
params = p_emb + p_ssm + p_ffn + p_norm + p_head;
active = params - p_emb + dm;
p_att_ref = param_count(causal_attention(dm, 1, 1));
print("MODEL --", variant, "params", params, "of which embedding", p_emb, "selective block", p_ssm, "(SS01's fixed-decay block 1056, DN01 attention", p_att_ref, ") ffn", p_ffn, "head", p_head, "; active per token", active, "; state", ds, "values");

curve_e = fill([0], 0);
curve_t = fill([0], 0);
curve_v = fill([0], 0);
train_ms = 0;
e = 0;
while lt(e, epochs) {
  ts = clock_ms();
  i = 0;
  while lt(i, ntrain) {
    x1 = take(train_x, 0, i);
    y1 = take(train_y, 0, i);
    m1 = take(train_m, 0, i);
    adam(u:masked_ce(u:body(apply(emb, x1) + posT, T), y1, m1, V), [emb, ssm_pre, ffn, norm, head, sel_Wa, sel_ba, sel_Wb, sel_Wc, sel_Wo], lr, 0.9, 0.999, 0.00000001);
    i = i + 1
  };
  train_ms = train_ms + (clock_ms() - ts);
  e = e + 1;
  if eq(mod(e, every), 0) {
    tl = emit_frame("ssm2/loss/train", e, u:set_loss(:u:forward, train_x, train_y, train_m, ntrain, V));
    vl = emit_frame("ssm2/loss/val", e, u:set_loss(:u:forward, val_x, val_y, val_m, nval, V));
    curve_e = concat(curve_e, e);
    curve_t = concat(curve_t, tl);
    curve_v = concat(curve_v, vl);
    print("epoch", e, variant, "train loss", u:svg_round(tl, 4), "val loss", u:svg_round(vl, 4))
  } else {
    0
  }
};
steps = epochs * ntrain;
ms_per_step = train_ms / steps;
ms_per_token = train_ms / (steps * T);

td = clock_ms();
rv = u:evaluate_prompts(:u:forward, d, s.val, 12);
decode_ms = clock_ms() - td;
rt = u:evaluate_prompts(:u:forward, d, s.train, 12);
val_acc = emit_frame("ssm2/accuracy/val", epochs, [rv.accuracy.arithmetic, rv.accuracy.sequence, rv.accuracy.mlpl, rv.accuracy.prose, rv.accuracy.overall]);
train_acc = emit_frame("ssm2/accuracy/train", epochs, [rt.accuracy.arithmetic, rt.accuracy.sequence, rt.accuracy.mlpl, rt.accuracy.prose, rt.accuracy.overall]);
final_val = take(curve_v, 0, reduce_mul(shape(curve_v)) - 1);
final_train = take(curve_t, 0, reduce_mul(shape(curve_t)) - 1);
ppl = exp(final_val);

arith_text = "17+25=|42.";
prose_text = "the cat sat on the |mat.";
arith_ids = unwrap(u:domain_encode(arith_text));
prose_ids = unwrap(u:domain_encode(prose_text));
n_arith = reduce_mul(shape(arith_ids));
n_prose = reduce_mul(shape(prose_ids));

def u:decay_of(ids, n) {
  "Mean decay per position of one window: how much of the state each token lets through, averaged over the state dimensions.";
  x = apply(ssm_pre, apply(emb, ids) + u:positions(n, dm));
  reduce_add(u:ssm_sel_decay(x, sel_Wa, sel_ba), 1) / ds
}

decay_arith = emit_frame("ssm2/decay/arith", epochs, u:decay_of(arith_ids, n_arith));
decay_prose = emit_frame("ssm2/decay/prose", epochs, u:decay_of(prose_ids, n_prose));
ex_ids = unwrap(u:domain_encode("2+3=|5."));
ex_x = apply(ssm_pre, apply(emb, ex_ids) + u:positions(7, dm));
ex_states = emit_frame("ssm2/state/example", epochs, u:ssm_sel_states(ex_x, sel_Wa, sel_ba, sel_Wb, sel_Wc, 7, ds));
ex_pred = emit_frame("ssm2/logits/example-argmax", epochs, argmax(u:forward(ex_ids), 1));
spread = emit_frame("ssm2/decay/spread", epochs, reduce_add(u:ssm_sel_decay(ex_x, sel_Wa, sel_ba), 0) / 7);
state_bytes = u:ssm_state_bytes(ds);

lesson = if wide {
  "SS02"
} else {
  "SS02m"
};
config_text = if wide {
  "selective ssm d16 s32 h32 T28 120ex 300ep lr0.003 (a,b,c from the token; state bytes as SS01)"
} else {
  "selective ssm d16 s16 h32 T28 120ex 300ep lr0.003 (a,b,c from the token; 1024 block params, matched to DN01 attention)"
};
row = {lesson: lesson, config: config_text, binary: binary, params: params, active_params: active, expert_evals: 1, bytes_per_token: active * 8, ms_per_token: u:svg_round(ms_per_token, 4), val_loss: u:svg_round(final_val, 4), ppl: u:svg_round(ppl, 2), arith_acc: u:svg_round(rv.accuracy.arithmetic, 3), seq_acc: u:svg_round(rv.accuracy.sequence, 3), mlpl_acc: u:svg_round(rv.accuracy.mlpl, 3), prose_acc: u:svg_round(rv.accuracy.prose, 3), state_bytes: str_concat(str_concat(u:svg_num(state_bytes), " / "), u:svg_num(state_bytes))};
r_row = if writing {
  write_atomic(str_concat(str_concat(out_dir, "/results-row-"), str_concat(variant, ".md")), str_concat(u:results_row(row), "\n"))
} else {
  ok(0)
};
metrics = {variant: variant, lesson: lesson, params: params, block_params: p_ssm, ds: ds, state_bytes: state_bytes, curve_e: curve_e, curve_t: curve_t, curve_v: curve_v, decay_arith: decay_arith, decay_prose: decay_prose, spread: spread, arith_text: arith_text, prose_text: prose_text};
r_metrics = if writing {
  write_atomic(str_concat(str_concat(out_dir, "/metrics-"), str_concat(variant, ".json")), unwrap(to_json(metrics)))
} else {
  ok(0)
};
print("MEMORY -- params", params, "active/token", active, "bytes/token (f64)", active * 8, "; persistent state", state_bytes, "B at every history; selective block", p_ssm, "params against SS01's 1056");
print("SPEED -- ms/step", u:svg_round(ms_per_step, 3), "ms/token", u:svg_round(ms_per_token, 4), "greedy decode ms for", nval, "prompts", u:svg_round(decode_ms, 1), "(", binary, ")");
print("QUALITY -- val loss", u:svg_round(final_val, 4), "ppl", u:svg_round(ppl, 2), "val acc [arith seq mlpl prose all]", val_acc, "train acc", train_acc);
print("DECAY -- arithmetic mean", u:svg_round(mean(decay_arith), 3), "range", u:svg_round(reduce(:min, decay_arith), 3), u:svg_round(reduce(:max, decay_arith), 3), "; prose mean", u:svg_round(mean(decay_prose), 3), "range", u:svg_round(reduce(:min, decay_prose), 3), u:svg_round(reduce(:max, decay_prose), 3));
print("NUMERICAL CONTRACT -- every gate stays inside (0, 1); the decay varies with the token (its range within a window is wider than 0.01); training loss ends below validation loss.");
print("THE POINT -- A fixed decay forgets on a schedule; a selective decay can hold one token and drop the next, which is what a sequence model needs at a boundary like the answer bar.");
print("BOUNDARY -- 90 training rows, one block, a sequential interpreter scan, one seed; the decay strips are one window each, not a statistic over the corpus.");
contract = reduce_mul(gt(decay_arith, 0)) * reduce_mul(lt(decay_arith, 1)) * gt(reduce(:max, decay_arith) - reduce(:min, decay_arith), 0.01) * lt(final_train, final_val);
if contract * is_ok(r_row) * is_ok(r_metrics) {
  ok("selective state-space block written")
} else {
  err("selective state-space block contract failed")
}
