# Recurrence contract: the shared block reused R times, deep supervision, R = 1 equal to the dense forward, active-parameter accounting, and a short training run.
include "lib/recur.mlpl";

dm = 16;
hidden = 32;
V = u:domain_vocab_size();
recur_att = chain(rms_norm(dm), causal_attention(dm, 1, 1));
recur_ffn = chain(rms_norm(dm), linear(dm, hidden, 2), relu_layer(), linear(hidden, dm, 3));
recur_norm = rms_norm(dm);
recur_head = linear(dm, V, 4);
emb = embed(V, dm, 0);

def u:dense_forward(h0) {
  "The DN01 body written out: one attention residual, one FFN residual, norm, head.";
  h1 = h0 + apply(recur_att, h0);
  h2 = h1 + apply(recur_ffn, h1);
  apply(recur_head, apply(recur_norm, h2))
}

@test {name: "one recurrence equals the dense forward and more recurrences change the state", tags: ["recur", "forward"]}
def u:test_forward() {
  "R = 1 is DN01's block; R = 3 applies the same weights three times.";
  ids = u:pad_to(unwrap(u:domain_encode("2+3=|5.")), 7);
  h0 = apply(emb, ids) + u:positions(7, dm);
  l1 = u:recur_logits(u:recur_state(h0, 1));
  u:assert_approx(reduce_add(abs(l1 - u:dense_forward(h0))), 0, 0.000000001, "R = 1 equals the dense body")?;
  s3 = u:recur_state(h0, 3);
  u:assert_shape(s3, [7, dm], "state shape")?;
  u:assert_gt(reduce_add(abs(s3 - u:recur_state(h0, 1))), 0.001, "three recurrences move the state")?;
  u:assert_approx(reduce_add(abs(u:recur_state(u:recur_state(h0, 1), 2) - s3)), 0, 0.000000001, "recurrence composes")
}

@test {name: "deep supervision averages the per-recurrence losses and equals the masked loss at R = 1", tags: ["recur", "loss"]}
def u:test_loss() {
  "The mean over recurrences of the head's masked loss.";
  w = unwrap(u:domain_window("2+3=|5.", 12));
  h0 = apply(emb, w.x) + u:positions(12, dm);
  l1 = u:recur_loss(h0, w.y, w.mask, V, 1);
  u:assert_approx(l1, u:masked_ce(u:recur_logits(u:recur_state(h0, 1)), w.y, w.mask, V), 0.000000001, "R = 1")?;
  l2 = u:recur_loss(h0, w.y, w.mask, V, 2);
  by_hand = (u:masked_ce(u:recur_logits(u:recur_state(h0, 1)), w.y, w.mask, V) + u:masked_ce(u:recur_logits(u:recur_state(h0, 2)), w.y, w.mask, V)) / 2;
  u:assert_approx(l2, by_hand, 0.000000001, "R = 2 is the mean of both recurrences")
}

@test {name: "active parameters grow with R while stored parameters do not", tags: ["recur", "params"]}
def u:test_params() {
  "Reuse is the point.";
  pa = param_count(recur_att);
  pf = param_count(recur_ffn);
  pn = param_count(recur_norm);
  ph = param_count(recur_head);
  a1 = u:recur_active_params(pa, pf, pn, ph, dm, 1);
  a4 = u:recur_active_params(pa, pf, pn, ph, dm, 4);
  u:assert_eq(a4 - a1, 3 * (pa + pf), "three more block applications")?;
  u:assert_eq(a1, 2996, "R = 1 matches DN01's active parameters per token")
}

@test {name: "a few deep-supervised steps reduce the loss at R = 2", tags: ["recur", "train"]}
def u:test_train() {
  "adam through repeat with a parameter-bound count.";
  w = unwrap(u:domain_window("17+25=|42.", 12));
  wx = w.x;
  wy = w.y;
  wm = w.mask;
  pos = u:positions(12, dm);
  before = u:recur_loss(apply(emb, wx) + pos, wy, wm, V, 2);
  k = 0;
  while lt(k, 25) {
    adam(u:recur_loss(apply(emb, wx) + pos, wy, wm, V, 2), [emb, recur_att, recur_ffn, recur_norm, recur_head], 0.01, 0.9, 0.999, 0.00000001);
    k = k + 1
  };
  u:assert_lt(u:recur_loss(apply(emb, wx) + pos, wy, wm, V, 2), before * 0.7, "loss fell (record fields bound eagerly, finding F17)")
}

u:run_registered_tests()
