# Data-scale helper contract: scaled mixtures keep ratios and the point record is complete.
include "lib/scale.mlpl";

@test {name: "a scaled mixture keeps ratios, window, and split fraction", tags: ["scale"]}
def u:test_scale_mixture() {
  "Only the total changes; counts scale with it.";
  m = u:scale_mixture(480);
  u:assert_eq(m.total, 480, "total")?;
  u:assert_eq(m.window, 28, "window unchanged")?;
  u:assert_eq(u:domain_counts(m), [168, 144, 120, 48], "family counts scale")?;
  s = u:domain_split(480, m.train_fraction, m.seed);
  u:assert_shape(s.train, [360], "three quarters train")
}

@test {name: "a sweep point records identity, finals, curves, and accuracy", tags: ["scale"]}
def u:test_scale_point() {
  "Final values come from the last checkpoint.";
  p = u:scale_point("dense", 120, 200, [50, 100], [1.0, 0.5], [2.0, 2.5], [0, 0, 0, 0.5, 0.1], [1, 1, 1, 1, 0.9], 1234);
  u:assert_text_eq(p.kind, "dense", "kind")?;
  u:assert_eq(p.curve_len, 2, "two checkpoints")?;
  u:assert_eq(p.final_val, 2.5, "final validation loss")?;
  u:assert_eq(p.acc_prose, 0.5, "prose accuracy")?;
  u:assert_eq(p.train_overall, 0.9, "training exact match")
}

u:run_registered_tests()
