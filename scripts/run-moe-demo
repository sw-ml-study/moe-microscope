#!/bin/sh
# Run MX01 into a temporary directory; check (or write) its diagrams and the deterministic columns of its results row.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
mode=${1:-check}
tmp_rel="tmp/moe-demo"
mkdir -p "$repo_root/$tmp_rel"
binary=$("$mlpl" --version 2>/dev/null | head -1 | tr -d '\n')

"$mlpl" --source-dir "$repo_root" "$repo_root/demos/moe_baseline.mlpl" -- "$tmp_rel" "$binary"

for name in moe-run moe-balance; do
    generated="$repo_root/$tmp_rel/$name.svg"
    committed="$repo_root/assets/previews/$name.svg"
    [ -s "$generated" ] || { echo "moe demo did not write $name.svg" >&2; exit 1; }
    if [ "$mode" = "write" ]; then
        cp "$generated" "$committed"
    elif ! cmp -s "$generated" "$committed"; then
        echo "$name.svg preview is stale; run scripts/run-moe-demo write" >&2
        exit 1
    fi
done

mkdir -p "$repo_root/fixtures/moe"
if [ "$mode" = "write" ]; then
    cp "$repo_root/$tmp_rel/family-by-expert.json" "$repo_root/fixtures/moe/mx01-family-by-expert.json"
elif ! cmp -s "$repo_root/$tmp_rel/family-by-expert.json" "$repo_root/fixtures/moe/mx01-family-by-expert.json"; then
    echo "MX01 family-by-expert fixture is stale; run scripts/run-moe-demo write" >&2
    exit 1
fi

# The row's deterministic columns (everything except binary and ms/token) must match docs/results.md.
row=$(cat "$repo_root/$tmp_rel/results-row.md")
key=$(printf '%s\n' "$row" | awk -F'|' '{ $4=""; $12=""; print }')
if [ "$mode" = "write" ]; then
    grep -q '^| MX01 |' "$repo_root/docs/results.md" && sed -i '' '/^| MX01 |/d' "$repo_root/docs/results.md"
    printf '%s\n' "$row" >> "$repo_root/docs/results.md"
else
    committed_key=$(grep '^| MX01 |' "$repo_root/docs/results.md" | awk -F'|' '{ $4=""; $12=""; print }')
    [ "$key" = "$committed_key" ] || {
        echo "MX01 results row differs from docs/results.md; run scripts/run-moe-demo write" >&2
        echo "generated: $key" >&2
        echo "committed: $committed_key" >&2
        exit 1
    }
fi
rm -rf "$repo_root/$tmp_rel"
echo "PASS moe baseline contract, previews, and results row ($mode)"
