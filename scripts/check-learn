#!/bin/sh
# The live demo page must reference only files the composed site contains, every JSON it reads must parse, and the footer must carry the required links.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
out="$repo_root/tmp/site"
"$repo_root/scripts/build-site" "$out" > /dev/null

for path in $(grep -o "fetch('[^']*')" "$repo_root/learn/app.js" | sed "s/fetch('//;s/')//"); do
    [ -f "$out/$path" ] || { echo "learn/app.js fetches $path, which the composed site does not contain" >&2; exit 1; }
    case "$path" in
        *.json) python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$out/$path" || { echo "$path is not valid JSON" >&2; exit 1; } ;;
    esac
done
for path in $(grep -o "fetch('[^']*')" "$repo_root/learn/landscape.js" | sed "s/fetch('//;s/')//") $(python3 -c 'import json,sys; print("\n".join(sorted({s["recording"] for s in json.load(open(sys.argv[1]))["scenes"] if s.get("recording")})))' "$repo_root/fixtures/landscape/scenes-v0.json"); do
    [ -f "$out/$path" ] || { echo "the landscape page reads $path, which the composed site does not contain" >&2; exit 1; }
    case "$path" in
        *.json) python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$out/$path" || { echo "$path is not valid JSON" >&2; exit 1; } ;;
    esac
done
for needle in 'https://software-wrighter-lab.github.io/sw-campus/' 'https://blog.softwarewrighter.com/' 'https://discord.com/invite/Ctzk5uHggZ' 'https://github.com/sw-ml-study/moe-microscope' 'https://github.com/sw-ml-study/moe-microscope/wiki' 'MIT License' 'Michael A Wright' 'build-info'; do
    grep -q -- "$needle" "$repo_root/learn/index.html" "$repo_root/learn/app.js" || { echo "the live demo footer is missing: $needle" >&2; exit 1; }
    grep -q -- "$needle" "$repo_root/learn/landscape.html" || { echo "the landscape footer is missing: $needle" >&2; exit 1; }
done
grep -q '<footer' "$repo_root/learn/index.html" || { echo "learn/index.html has no footer" >&2; exit 1; }
grep -q '<footer' "$repo_root/learn/landscape.html" || { echo "learn/landscape.html has no footer" >&2; exit 1; }
rm -rf "$out"
echo "PASS live demo and landscape pages reference committed files only and carry the footer"
