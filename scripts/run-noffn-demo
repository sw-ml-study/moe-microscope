#!/bin/sh
# Run SAN01 once per variant (hashed, wordvec; one process each, finding F22), draw the comparison diagram from the docent results table, and check (or write) the two diagrams and the two docent results rows.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
mode=${1:-check}
. "$repo_root/scripts/gate-cache"
gate_cache_start "$mode" run-noffn-demo \
    demos/docent_noffn.mlpl demos/docent_noffn_diagram.mlpl \
    assets/previews/noffn-model.svg assets/previews/noffn-comparison.svg \
    "row:docs/reference/docent-results.md:| SAN01 |" "row:docs/reference/docent-results.md:| SAN01b |"
tmp_rel="tmp/noffn-demo"
rm -rf "$repo_root/$tmp_rel"
mkdir -p "$repo_root/$tmp_rel"
binary=$("$mlpl" --version 2>/dev/null | head -1 | tr -d '\n')
table="$repo_root/docs/reference/docent-results.md"

for variant in hashed wordvec; do
    "$mlpl" --source-dir "$repo_root" "$repo_root/demos/docent_noffn.mlpl" -- "$tmp_rel" "$binary" "$variant"
    row=$(cat "$repo_root/$tmp_rel/results-row-$variant.md")
    lesson=$(printf '%s\n' "$row" | awk -F'|' '{ gsub(/ /, "", $2); print $2 }')
    key=$(printf '%s\n' "$row" | awk -F'|' '{ $4=""; $9=""; print }')
    if [ "$mode" = "write" ]; then
        grep -q "^| $lesson |" "$table" && sed -i '' "/^| $lesson |/d" "$table"
        printf '%s\n' "$row" >> "$table"
    else
        committed_key=$(grep "^| $lesson |" "$table" | awk -F'|' '{ $4=""; $9=""; print }')
        [ "$key" = "$committed_key" ] || {
            echo "$lesson results row differs from $table; run scripts/run-noffn-demo write" >&2
            echo "generated: $key" >&2
            echo "committed: $committed_key" >&2
            exit 1
        }
    fi
done

"$mlpl" --source-dir "$repo_root" "$repo_root/demos/docent_noffn_diagram.mlpl" -- "$tmp_rel"

for name in noffn-model noffn-comparison; do
    generated="$repo_root/$tmp_rel/$name.svg"
    committed="$repo_root/assets/previews/$name.svg"
    [ -s "$generated" ] || { echo "noffn demo did not write $name.svg" >&2; exit 1; }
    if [ "$mode" = "write" ]; then
        cp "$generated" "$committed"
    elif ! cmp -s "$generated" "$committed"; then
        echo "$name.svg preview is stale; run scripts/run-noffn-demo write" >&2
        exit 1
    fi
done
rm -rf "$repo_root/$tmp_rel"
gate_cache_record "$mode"
echo "PASS no-FFN docent contract, previews, and results rows ($mode)"
