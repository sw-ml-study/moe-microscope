#!/bin/sh
# Probe the connect path: emit_frame inside train and while loops must stream every iteration in order; include has no source provider there (F16).
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
server=$("$repo_root/scripts/select-mlpl-serve")
port=${MOE_PROBE_PORT:-16492}
base_url="http://127.0.0.1:$port"
log_file=$(mktemp)
response_file=$(mktemp)

cleanup() {
    if [ -n "${server_pid:-}" ]; then
        kill "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    rm -f "$log_file" "$response_file"
}
trap cleanup EXIT HUP INT TERM

command -v curl >/dev/null 2>&1 || { echo "curl is required" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "jq is required" >&2; exit 1; }

"$server" --bind "127.0.0.1:$port" --auth disabled >"$log_file" 2>&1 &
server_pid=$!
attempt=0
until curl --fail --silent "$base_url/v1/health" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 50 ] || ! kill -0 "$server_pid" 2>/dev/null; then
        echo "mlpl-serve did not become ready" >&2
        exit 1
    fi
    sleep 0.1
done

run_program() {
    session=$(curl --fail --silent --request POST "$base_url/v1/sessions")
    session_id=$(printf '%s' "$session" | jq -r '.session_id')
    token=$(printf '%s' "$session" | jq -r '.token')
    body=$(jq -nc --arg program "$1" '{program: $program}')
    curl --fail --silent --no-buffer \
        --header "Authorization: Bearer $token" \
        --header 'Content-Type: application/json' \
        --data "$body" \
        "$base_url/v1/sessions/$session_id/eval_stream" >"$response_file"
}

run_program 'train 3 { emit_frame("t/loss", step, step * 2); 0 }'
frames=$(sed -n 's/^data: *//p' "$response_file" | jq -c 'select(.shape != null) | [.name, .step, .values]' | tr '\n' ' ')
[ "$frames" = '["t/loss",0,[0.0]] ["t/loss",1,[2.0]] ["t/loss",2,[4.0]] ' ] || {
    echo "train loop did not stream every step: $frames" >&2
    exit 1
}
echo "PASS emit_frame inside train streams every step in order (metric events interleave)"

run_program 'i = 0; while lt(i, 3) { emit_frame("w/x", i, [i, i]); i = i + 1 }'
frames=$(sed -n 's/^data: *//p' "$response_file" | jq -c 'select(.shape != null) | [.name, .step, .values]' | tr '\n' ' ')
[ "$frames" = '["w/x",0,[0.0,0.0]] ["w/x",1,[1.0,1.0]] ["w/x",2,[2.0,2.0]] ' ] || {
    echo "while loop did not stream every iteration: $frames" >&2
    exit 1
}
echo "PASS emit_frame inside while streams every iteration in order"

run_program 'include "lib/observe.mlpl"; 1'
grep -q 'include is a script-mode construct' "$response_file" || {
    echo "F16 changed: include is now accepted on the eval_stream surface; update docs/reference/sw-mlpl-findings.md and scripts/bundle-program" >&2
    exit 1
}
echo "PASS probe F16 still reproduces: eval_stream has no source provider for include"
