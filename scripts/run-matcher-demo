#!/bin/sh
# Run MB01, the deterministic matcher baseline, into a temporary directory; check (or write) its diagram and the deterministic columns of its two docent results rows.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
mode=${1:-check}
. "$repo_root/scripts/gate-cache"
gate_cache_start "$mode" run-matcher-demo \
    demos/matcher_baseline.mlpl assets/previews/matcher-scores.svg \
    "row:docs/reference/docent-results.md:| MB01 |" \
    "row:docs/reference/docent-results.md:| MB01t |"
tmp_rel="tmp/matcher-demo"
mkdir -p "$repo_root/$tmp_rel"
binary=$("$mlpl" --version 2>/dev/null | head -1 | tr -d '\n')

"$mlpl" --source-dir "$repo_root" "$repo_root/demos/matcher_baseline.mlpl" -- "$tmp_rel" "$binary"

generated="$repo_root/$tmp_rel/matcher-scores.svg"
committed="$repo_root/assets/previews/matcher-scores.svg"
[ -s "$generated" ] || { echo "matcher demo did not write matcher-scores.svg" >&2; exit 1; }
if [ "$mode" = "write" ]; then
    cp "$generated" "$committed"
elif ! cmp -s "$generated" "$committed"; then
    echo "matcher-scores.svg preview is stale; run scripts/run-matcher-demo write" >&2
    exit 1
fi

# Both rows' deterministic columns (everything except binary and ms/query) must match docs/reference/docent-results.md.
table="$repo_root/docs/reference/docent-results.md"
for lesson in MB01 MB01t; do
    row=$(grep "^| $lesson |" "$repo_root/$tmp_rel/results-rows.md")
    key=$(printf '%s\n' "$row" | awk -F'|' '{ $4=""; $9=""; print }')
    if [ "$mode" = "write" ]; then
        grep -q "^| $lesson |" "$table" && sed -i '' "/^| $lesson |/d" "$table"
        printf '%s\n' "$row" >> "$table"
    else
        committed_key=$(grep "^| $lesson |" "$table" | awk -F'|' '{ $4=""; $9=""; print }')
        [ "$key" = "$committed_key" ] || {
            echo "$lesson results row differs from $table; run scripts/run-matcher-demo write" >&2
            echo "generated: $key" >&2
            echo "committed: $committed_key" >&2
            exit 1
        }
    fi
done
rm -rf "$repo_root/$tmp_rel"
gate_cache_record "$mode"
echo "PASS matcher baseline contract, preview, and results rows ($mode)"
