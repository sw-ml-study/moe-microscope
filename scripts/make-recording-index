#!/bin/sh
# Regenerate fixtures/recordings/index-v1.json from scripts/recordings.conf: every committed recording, its lesson source, and its bundled program, pinned by SHA-256.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
revision=$(git -C "$repo_root" rev-parse HEAD)
entries=""
while IFS='|' read -r id lesson demo recording preview mf mo mv mt first last; do
    case "$id" in ''|\#*) continue ;; esac
    [ -f "$repo_root/$recording" ] || continue
    entry=$(jq -n \
        --arg id "$id" --arg lesson "$lesson" --arg source "$demo" --arg recording "$recording" --arg preview "$preview" \
        --arg recording_sha256 "$(shasum -a 256 "$repo_root/$recording" | awk '{print $1}')" \
        --arg source_sha256 "$(shasum -a 256 "$repo_root/$demo" | awk '{print $1}')" \
        --arg bundle_sha256 "$("$repo_root/scripts/bundle-program" "$repo_root/$demo" | shasum -a 256 | awk '{print $1}')" \
        --argjson frame_count "$(jq '[.frames[]] | length' "$repo_root/$recording")" \
        --argjson observation_count "$(jq '[.frames[].observations[]] | length' "$repo_root/$recording")" \
        --argjson value_count "$(jq '[.frames[].observations[].values | length] | add' "$repo_root/$recording")" \
        --argjson steps "$(jq -c '[.frames[].step]' "$repo_root/$recording")" \
        '{id: $id, lesson: $lesson, source: $source, recording: $recording, preview: $preview, guide: "docs/implementation/host-handoff.md", recording_sha256: $recording_sha256, source_sha256: $source_sha256, bundle_sha256: $bundle_sha256, frame_count: $frame_count, observation_count: $observation_count, value_count: $value_count, steps: $steps}')
    entries="$entries$entry"
done < "$repo_root/scripts/recordings.conf"
printf '%s' "$entries" | jq -s --arg revision "$revision" '{schema: "sw-ml-study.ml-microscope-fixture-index", version: 1, recording_schema: "fixtures/recordings/recording-schema-v0.json", source_repository: "https://github.com/sw-ml-study/moe-microscope.git", source_revision: $revision, bundler: "scripts/bundle-program", fixtures: .}' > "$repo_root/fixtures/recordings/index-v1.json"
echo "wrote fixtures/recordings/index-v1.json at $revision with $(jq '.fixtures | length' "$repo_root/fixtures/recordings/index-v1.json") fixtures"
