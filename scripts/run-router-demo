#!/bin/sh
# Run the MX01 routing microscope into a temporary directory and require its diagram to match the committed preview.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
mode=${1:-check}
. "$repo_root/scripts/gate-cache"
gate_cache_start "$mode" run-router-demo \
    demos/router_microscope.mlpl assets/previews/router-routing.svg
tmp_rel="tmp/router-demo"
mkdir -p "$repo_root/$tmp_rel"

"$mlpl" --source-dir "$repo_root" "$repo_root/demos/router_microscope.mlpl" -- "$tmp_rel"

generated="$repo_root/$tmp_rel/router-routing.svg"
committed="$repo_root/assets/previews/router-routing.svg"
[ -s "$generated" ] || { echo "router demo did not write router-routing.svg" >&2; exit 1; }
if [ "$mode" = "write" ]; then
    cp "$generated" "$committed"
elif ! cmp -s "$generated" "$committed"; then
    echo "router-routing.svg preview is stale; run scripts/run-router-demo write" >&2
    exit 1
fi
rm -rf "$repo_root/$tmp_rel"
gate_cache_record "$mode"
echo "PASS routing microscope contract and preview freshness ($mode)"
