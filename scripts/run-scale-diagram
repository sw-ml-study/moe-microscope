#!/bin/sh
# Draw the DS01 diagram from the committed scale points (no training) and check or write the preview.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
mode=${1:-check}
tmp_rel="tmp/scale-diagram"
mkdir -p "$repo_root/$tmp_rel"
"$mlpl" --source-dir "$repo_root" "$repo_root/demos/scale_microscope.mlpl" -- "$tmp_rel"
generated="$repo_root/$tmp_rel/scale-sweep.svg"
committed="$repo_root/assets/previews/scale-sweep.svg"
[ -s "$generated" ] || { echo "scale diagram not written" >&2; exit 1; }
if [ "$mode" = "write" ]; then
    cp "$generated" "$committed"
elif ! cmp -s "$generated" "$committed"; then
    echo "scale-sweep.svg is stale; run scripts/run-scale-diagram write" >&2
    exit 1
fi
rm -rf "$repo_root/$tmp_rel"
echo "PASS scale diagram freshness ($mode)"
