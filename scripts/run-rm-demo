#!/bin/sh
# Run RM01 once per R (2 and 3; one process each, finding F22), compose the diagrams from the metrics, and check (or write) the three diagrams and the two results rows.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
mode=${1:-check}
. "$repo_root/scripts/gate-cache"
gate_cache_start "$mode" run-rm-demo \
    demos/recurrent_moe.mlpl demos/recurrent_moe_diagrams.mlpl assets/previews/rm-strip.svg \
    assets/previews/rm-change.svg assets/previews/rm-maps.svg \
    "row:docs/reference/results.md:| RM01@2 |" "row:docs/reference/results.md:| RM01@3 |" \
    conf:RM01
tmp_rel="tmp/rm-demo"
rm -rf "$repo_root/$tmp_rel"
mkdir -p "$repo_root/$tmp_rel"
binary=$("$mlpl" --version 2>/dev/null | head -1 | tr -d '\n')
table="$repo_root/docs/reference/results.md"

for r in 2 3; do
    "$mlpl" --source-dir "$repo_root" "$repo_root/demos/recurrent_moe.mlpl" -- "$tmp_rel" "$binary" "$r"
    lesson="RM01@$r"
    row=$(grep "^| $lesson |" "$repo_root/$tmp_rel/results-rows.md")
    key=$(printf '%s\n' "$row" | awk -F'|' '{ $4=""; $12=""; print }')
    if [ "$mode" = "write" ]; then
        grep -q "^| $lesson |" "$table" && sed -i '' "/^| $lesson |/d" "$table"
        printf '%s\n' "$row" >> "$table"
    else
        committed_key=$(grep "^| $lesson |" "$table" | awk -F'|' '{ $4=""; $12=""; print }')
        [ "$key" = "$committed_key" ] || {
            echo "$lesson results row differs from $table; run scripts/run-rm-demo write" >&2
            echo "generated: $key" >&2
            echo "committed: $committed_key" >&2
            exit 1
        }
    fi
done

"$mlpl" --source-dir "$repo_root" "$repo_root/demos/recurrent_moe_diagrams.mlpl" -- "$tmp_rel"

for name in rm-strip rm-change rm-maps; do
    generated="$repo_root/$tmp_rel/$name.svg"
    committed="$repo_root/assets/previews/$name.svg"
    [ -s "$generated" ] || { echo "rm demo did not write $name.svg" >&2; exit 1; }
    if [ "$mode" = "write" ]; then
        cp "$generated" "$committed"
    elif ! cmp -s "$generated" "$committed"; then
        echo "$name.svg preview is stale; run scripts/run-rm-demo write" >&2
        exit 1
    fi
done
rm -rf "$repo_root/$tmp_rel"
gate_cache_record "$mode"
echo "PASS recurrent mixture contract, previews, and results rows ($mode)"
