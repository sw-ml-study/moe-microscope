#!/bin/sh
# Run each upstream-finding reproducer and require the documented outcome, so an upstream fix is noticed here.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")

expect_error() {
    name=$1
    pattern=$2
    output=$("$mlpl" --source-dir "$repo_root" "$repo_root/probes/$name.mlpl" 2>&1 || true)
    printf '%s\n' "$output" | grep -q -- "$pattern" || {
        echo "probe $name: expected '$pattern'; upstream behavior changed, update docs/reference/sw-mlpl-findings.md" >&2
        printf '%s\n' "$output" | tail -3 >&2
        exit 1
    }
    echo "PASS probe $name still reproduces: $pattern"
}

expect_ok() {
    name=$1
    pattern=$2
    output=$("$mlpl" --source-dir "$repo_root" "$repo_root/probes/$name.mlpl" 2>&1) || {
        echo "probe $name: expected success; it now fails" >&2
        printf '%s\n' "$output" | tail -3 >&2
        exit 1
    }
    printf '%s\n' "$output" | grep -q -- "$pattern" || { echo "probe $name: expected '$pattern'" >&2; exit 1; }
    echo "PASS probe $name resolved upstream: $pattern"
}

expect_output() {
    name=$1
    pattern=$2
    output=$("$mlpl" --source-dir "$repo_root" "$repo_root/probes/$name.mlpl" 2>&1) || {
        echo "probe $name: expected success; it now fails" >&2
        printf '%s\n' "$output" | tail -3 >&2
        exit 1
    }
    printf '%s\n' "$output" | grep -q -- "$pattern" || { echo "probe $name: expected '$pattern'; upstream behavior changed, update docs/reference/sw-mlpl-findings.md" >&2; exit 1; }
    echo "PASS probe $name still reproduces: $pattern"
}

expect_ok f5_one_hot_in_grad "^mask-in-loss gradient"
expect_ok f6_repeat_in_grad "^repeat-in-grad gradient"
expect_error f7_model_argument "must be an array, Result, string"
expect_error f8_emit_frame_name "name must be a string literal"
expect_ok f9_embed_batch "^batched embed shape 2 3 4"
expect_ok f10_labeled_axes_on_tape "^trained loss"
expect_ok f11_nested_param_binding_in_grad "^grad rows 0 0 0"
expect_ok f12_size_arithmetic_in_grad "^grad 3 3 3"
expect_ok f13_attention_weights_residual "^weights 5 5"
expect_ok f14_fill_in_grad "^fill-in-grad gradient 2 2 2"
expect_ok f15_repeat_param_count "^grad 1.5 1.5"
expect_error f17_record_field_in_grad "expression form not supported inside grad"
expect_error f18_shape_mismatch_panics_on_tape "shape mismatch"
expect_error f19_matmul_shape_panics_in_grad "compatible matmul shapes"
expect_error f20_take_param_index_in_grad "undefined variable: e"
expect_output f21_adam_in_user_function "^param moved 0 model moved 0"
expect_output f22_adam_state_by_name "same 0$"
expect_error f23_shape_derived_reshape_in_grad "does not depend on 'W'"
"$mlpl" --source-dir "$repo_root" "$repo_root/probes/f18_shape_mismatch_panics_on_tape.mlpl" 2>&1 | grep -q panicked && { echo "probe f18: the tape panicked again" >&2; exit 1; }

expect_error d1_silent_zero_grad "the loss does not depend on"
