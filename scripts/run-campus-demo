#!/bin/sh
# Run the CD00 campus corpus microscope into a temporary directory; check (or write) its four diagrams, the corpus fixture, and the deterministic columns of its results row.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
mode=${1:-check}
tmp_rel="tmp/campus-demo"
mkdir -p "$repo_root/$tmp_rel"
binary=$("$mlpl" --version 2>/dev/null | head -1 | tr -d '\n')

"$mlpl" --source-dir "$repo_root" "$repo_root/demos/campus_corpus.mlpl" -- "$tmp_rel" "$binary"

for name in campus-snapshot campus-corpus campus-split campus-stories; do
    generated="$repo_root/$tmp_rel/$name.svg"
    committed="$repo_root/assets/previews/$name.svg"
    [ -s "$generated" ] || { echo "campus demo did not write $name.svg" >&2; exit 1; }
    if [ "$mode" = "write" ]; then
        cp "$generated" "$committed"
    elif ! cmp -s "$generated" "$committed"; then
        echo "$name.svg preview is stale; run scripts/run-campus-demo write" >&2
        exit 1
    fi
done

generated="$repo_root/$tmp_rel/corpus-a.json"
committed="$repo_root/fixtures/campus/corpus-a.json"
[ -s "$generated" ] || { echo "campus demo did not write corpus-a.json" >&2; exit 1; }
if [ "$mode" = "write" ]; then
    cp "$generated" "$committed"
elif ! cmp -s "$generated" "$committed"; then
    echo "fixtures/campus/corpus-a.json is stale; run scripts/run-campus-demo write" >&2
    exit 1
fi

# The row's deterministic columns (everything except binary and ms/token) must match docs/reference/results.md.
row=$(cat "$repo_root/$tmp_rel/results-row.md")
key=$(printf '%s\n' "$row" | awk -F'|' '{ $4=""; $12=""; print }')
if [ "$mode" = "write" ]; then
    grep -q '^| CD00 |' "$repo_root/docs/reference/results.md" && sed -i '' '/^| CD00 |/d' "$repo_root/docs/reference/results.md"
    printf '%s\n' "$row" >> "$repo_root/docs/reference/results.md"
else
    committed_key=$(grep '^| CD00 |' "$repo_root/docs/reference/results.md" | awk -F'|' '{ $4=""; $12=""; print }')
    [ "$key" = "$committed_key" ] || {
        echo "CD00 results row differs from docs/reference/results.md; run scripts/run-campus-demo write" >&2
        echo "generated: $key" >&2
        echo "committed: $committed_key" >&2
        exit 1
    }
fi
rm -rf "$repo_root/$tmp_rel"
echo "PASS campus corpus contract, previews, fixture, and results row ($mode)"
