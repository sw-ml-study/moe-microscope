#!/bin/sh
# Run the domain microscope into a temporary directory and require its three diagrams to match the committed previews.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
mode=${1:-check}
tmp_rel="tmp/domain-demo"
mkdir -p "$repo_root/$tmp_rel"

"$mlpl" --source-dir "$repo_root" "$repo_root/demos/domain_microscope.mlpl" -- "$tmp_rel"

for name in domain-window domain-tags domain-split; do
    generated="$repo_root/$tmp_rel/$name.svg"
    committed="$repo_root/assets/previews/$name.svg"
    [ -s "$generated" ] || { echo "domain demo did not write $name.svg" >&2; exit 1; }
    if [ "$mode" = "write" ]; then
        cp "$generated" "$committed"
    elif ! cmp -s "$generated" "$committed"; then
        echo "$name.svg preview is stale; run scripts/run-domain-demo write" >&2
        exit 1
    fi
done
rm -rf "$repo_root/$tmp_rel"
echo "PASS domain microscope contract and preview freshness ($mode)"
