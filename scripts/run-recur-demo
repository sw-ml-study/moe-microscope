#!/bin/sh
# Run RC01 once per R (one process each: adam state is keyed by name, finding F22), compose the sweep diagram, and check (or write) the three diagrams and the four results rows.
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
mode=${1:-check}
. "$repo_root/scripts/gate-cache"
gate_cache_start "$mode" run-recur-demo \
    demos/recurrent_block.mlpl demos/recurrent_sweep.mlpl assets/previews/recur-structure.svg \
    assets/previews/recur-sweep.svg assets/previews/recur-window.svg \
    "row:docs/reference/results.md:| RC01@1 |" "row:docs/reference/results.md:| RC01@2 |" \
    "row:docs/reference/results.md:| RC01@3 |" "row:docs/reference/results.md:| RC01@4 |" \
    conf:RC01
tmp_rel="tmp/recur-demo"
rm -rf "$repo_root/$tmp_rel"
mkdir -p "$repo_root/$tmp_rel"
binary=$("$mlpl" --version 2>/dev/null | head -1 | tr -d '\n')
table="$repo_root/docs/reference/results.md"

for r in 1 2 3 4; do
    "$mlpl" --source-dir "$repo_root" "$repo_root/demos/recurrent_block.mlpl" -- "$tmp_rel" "$binary" "$r"
    lesson="RC01@$r"
    row=$(grep "^| $lesson |" "$repo_root/$tmp_rel/results-rows.md")
    key=$(printf '%s\n' "$row" | awk -F'|' '{ $4=""; $12=""; print }')
    if [ "$mode" = "write" ]; then
        grep -q "^| $lesson |" "$table" && sed -i '' "/^| $lesson |/d" "$table"
        printf '%s\n' "$row" >> "$table"
    else
        committed_key=$(grep "^| $lesson |" "$table" | awk -F'|' '{ $4=""; $12=""; print }')
        [ "$key" = "$committed_key" ] || {
            echo "$lesson results row differs from $table; run scripts/run-recur-demo write" >&2
            echo "generated: $key" >&2
            echo "committed: $committed_key" >&2
            exit 1
        }
    fi
done

"$mlpl" --source-dir "$repo_root" "$repo_root/demos/recurrent_sweep.mlpl" -- "$tmp_rel"

for name in recur-structure recur-sweep recur-window; do
    generated="$repo_root/$tmp_rel/$name.svg"
    committed="$repo_root/assets/previews/$name.svg"
    [ -s "$generated" ] || { echo "recur demo did not write $name.svg" >&2; exit 1; }
    if [ "$mode" = "write" ]; then
        cp "$generated" "$committed"
    elif ! cmp -s "$generated" "$committed"; then
        echo "$name.svg preview is stale; run scripts/run-recur-demo write" >&2
        exit 1
    fi
done
rm -rf "$repo_root/$tmp_rel"
gate_cache_record "$mode"
echo "PASS recurrent block contract, previews, and results rows ($mode)"
