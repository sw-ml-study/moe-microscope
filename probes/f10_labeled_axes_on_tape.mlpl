# F10 reproducer, resolved in the rebuilt upstream binary: a labeled sinusoidal_encoding table through a residual attention block now trains inside adam.
emb = embed(20, 8, 0)
body = chain(residual(chain(rms_norm(8), causal_attention(8, 1, 1))), linear(8, 20, 2))
x = rand_ints(12, 0, 20, 5)
y = rand_ints(12, 0, 20, 6)
pos = sinusoidal_encoding(12, 8)
print("eager loss", cross_entropy(apply(body, apply(emb, x) + pos), y))
train 1 {
  adam(cross_entropy(apply(body, apply(emb, x) + pos), y), [emb, body], 0.01, 0.9, 0.999, 0.00000001);
  0
}
print("trained loss", cross_entropy(apply(body, apply(emb, x) + pos), y))
