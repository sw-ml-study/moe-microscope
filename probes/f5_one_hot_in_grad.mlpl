# F5 reproducer, now resolved upstream (54ad5849): one_hot and argmax are stop-gradient constants inside grad.
W = param[3, 2]
W = randn(1, [3, 2])
x = randn(2, [4, 3])
g = grad(reduce_add(softmax(matmul(x, W)) * one_hot(argmax(matmul(x, W), 1), 2)), W)
print("mask-in-loss gradient", shape(g), gt(reduce_add(abs(g)), 0))
