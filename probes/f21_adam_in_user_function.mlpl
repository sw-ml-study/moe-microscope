# F21 reproducer: adam called inside a user function trains function-local copies; the global model and param are unchanged after the call; checked by scripts/run-probes.
W = param[2, 1];
W = reshape([1, 1], [2, 1]);
h = linear(1, 1, 3);
x = reshape([1, 2], [1, 2]);
def u:step() {
  "One adam step over the global param and model.";
  adam(reduce_add(apply(h, matmul(x, W)) * apply(h, matmul(x, W))), [W, h], 0.1, 0.9, 0.999, 0.00000001)
}
before_w = reduce_add(W);
before_h = reduce_add(apply(h, reshape([1], [1, 1])));
r = u:step();
r = u:step();
after_w = reduce_add(W);
after_h = reduce_add(apply(h, reshape([1], [1, 1])));
print("param moved", gt(abs(after_w - before_w), 0), "model moved", gt(abs(after_h - before_h), 0));
adam(reduce_add(apply(h, matmul(x, W)) * apply(h, matmul(x, W))), [W, h], 0.1, 0.9, 0.999, 0.00000001);
print("top level param moved", gt(abs(reduce_add(W) - after_w), 0));
