# F15 reproducer, resolved upstream (369cfeb1): a repeat count bound to a user-function parameter resolves in the traced scope.
W = param[2, 2]
W = [[0.5, 0], [0, 0.5]]
def u:recurn(x0, r) {
  "Apply W r times with repeat.";
  s = x0;
  repeat r {
    s = matmul(s, W)
  };
  s
}
print("eager", u:recurn([[1, 1], [1, 1]], 3))
print("grad", grad(reduce_add(u:recurn([[1, 1], [1, 1]], 3)), W))
