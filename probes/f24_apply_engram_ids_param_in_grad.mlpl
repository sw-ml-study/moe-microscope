# F24 reproducer, resolved upstream (1b4d29e5): apply_engram's ids argument bound to a user-function parameter resolves in the traced scope, so the parameter form gives the same gradient as the global form; checked by scripts/run-probes.
e = engram(4, [2], 1, 8, 4, 7);
__engram_mem_0 = randn(3, [8, 4]) * 0.1;
h = reshape(range(12), [3, 4]) * 0.1;
ids = [1, 2, 3];
def u:with_global(h) {
  "ids from a global";
  reduce_add(apply_engram(e, h, ids) * apply_engram(e, h, ids))
}
def u:with_param(h, ids2) {
  "ids from a parameter";
  reduce_add(apply_engram(e, h, ids2) * apply_engram(e, h, ids2))
}
print("global grad", reduce_add(abs(grad(u:with_global(h), __engram_mem_0))));
print("parameter grad", reduce_add(abs(grad(u:with_param(h, ids), __engram_mem_0))));
