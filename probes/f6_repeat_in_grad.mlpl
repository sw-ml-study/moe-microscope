# F6 reproducer, resolved upstream (a9ae2a79): repeat with a literal count inside a traced user function unrolls onto the tape.
W = param[2, 2]
W = [[0.5, 0], [0, 0.5]]
def u:recur3(x0) {
  "Apply W three times with repeat.";
  s = x0;
  repeat 3 {
    s = matmul(s, W)
  };
  s
}
print("repeat-in-grad gradient", grad(reduce_add(u:recur3([[1, 1], [1, 1]])), W))
