# F6 reproducer: repeat inside a traced user function is rejected; expected error text is checked by scripts/run-probes.
W = param[2, 2]
W = [[0.5, 0], [0, 0.5]]
def u:recurn(x0, r) {
  "Apply W r times with repeat.";
  s = x0;
  repeat r {
    s = matmul(s, W)
  };
  s
}
grad(reduce_add(u:recurn([[1, 1], [1, 1]], 3)), W)
