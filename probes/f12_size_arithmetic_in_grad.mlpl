# F12 reproducer: shape-derived size arithmetic (reduce_mul(shape(...))) is rejected inside grad; checked by scripts/run-probes.
W = param[4, 3]
W = reshape(range(12), [4, 3])
print("eager width", reduce_mul(shape(take(W, 0, 0))))
print("grad", grad(reduce_add(W) * reduce_mul(shape(take(W, 0, 0))), W))
